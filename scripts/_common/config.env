#!/bin/bash
# ==============================================================================
# SINGLE SOURCE OF TRUTH (SSOT) - Environment Configuration
# ==============================================================================
# Consolidated from:
#  - .env.deployment (API, basic services)
#  - .env.infrastructure (endpoints, hosts)
#  - .env.cluster (replication, observability)
#  - terraform/environments/*/variables.tf (IaC variables)
#
# Usage: source scripts/_common/config.env
# This is the canonical source for ALL environment variables in the project
# ==============================================================================

# Export all variables so they're available to sourced scripts
set -a

# ==============================================================================
# INFRASTRUCTURE TOPOLOGY (Immutable - from IaC or DNS)
# ==============================================================================
# Cluster VIP/hosts must be set before sourcing this file
PRIMARY_HOST="${PRIMARY_HOST:-192.168.168.31}"
REPLICA_HOST="${REPLICA_HOST:-192.168.168.42}"
NAS_HOST="${NAS_HOST:-192.168.168.56}"
CLUSTER_VIP="${CLUSTER_VIP:-192.168.168.250}"

# NAS Mount
NAS_MOUNT_PATH="${NAS_MOUNT_PATH:-/mnt/nas}"

# ==============================================================================
# DOMAIN & TLS CONFIGURATION (SSOT)
# ==============================================================================
APEX_DOMAIN="${APEX_DOMAIN:-kushnir.cloud}"
ADMIN_EMAIL="${ADMIN_EMAIL:-admin@kushnir.cloud}"

# TLS Certificate Management (for Terraform/cert-manager)
TLS_PROVIDER="${TLS_PROVIDER:-letsencrypt-prod}"
TLS_EMAIL="${TLS_EMAIL:-${ADMIN_EMAIL}}"

# ==============================================================================
# API GATEWAY CONFIGURATION
# ==============================================================================
API_PROTOCOL="${API_PROTOCOL:-http}"
API_HOST="${API_HOST:-${PRIMARY_HOST}}"
API_PORT="${API_PORT:-8080}"

# Constructed endpoints (read-only)
API_ENDPOINT="${API_PROTOCOL}://${API_HOST}:${API_PORT}"
API_HEALTH_ENDPOINT="${API_ENDPOINT}/health"
API_OAUTH_CALLBACK="${API_ENDPOINT}/oauth/callback"

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
AUTH_DOMAIN="${AUTH_DOMAIN:-${APEX_DOMAIN}}"
OAUTH2_CLIENT_ID="${OAUTH2_CLIENT_ID:-dev-oauth2-client}"
OAUTH2_CLIENT_SECRET="${OAUTH2_CLIENT_SECRET:-dev-oauth2-secret}"
OAUTH2_COOKIE_SECRET="${OAUTH2_COOKIE_SECRET:-1dPVh9zxPN1E38JnQx+axQzmnZxuPDXX}"

# API Keys for service-to-service communication
SCHEDULER_API_KEY="${SCHEDULER_API_KEY:-dev-scheduler-key-12345}"
OPA_API_KEY="${OPA_API_KEY:-dev-opa-key-12345}"

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================================================
# Single source for all database configuration
DB_USER="${DB_USER:-postgres}"
DB_PASSWORD="${DB_PASSWORD:-postgres-dev-password}"
DB_NAME="${DB_NAME:-devos}"
POSTGRES_DB="${POSTGRES_DB:-kushnir_db}"
POSTGRES_USER="${POSTGRES_USER:-postgres}"
POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-k8s_secure_postgres_2026}"

# Replication configuration
POSTGRES_INITDB_ARGS="${POSTGRES_INITDB_ARGS:--c max_wal_senders=10 -c wal_level=replica}"

# Container name (canonical - from service-names.env)
POSTGRES_CONTAINER_NAME="${POSTGRES_CONTAINER_NAME:-code-server-postgres}"

# Endpoint (constructed)
POSTGRES_HOST="${POSTGRES_HOST:-${PRIMARY_HOST}}"
POSTGRES_PORT="${POSTGRES_PORT:-5432}"
POSTGRES_ENDPOINT="postgresql://${DB_USER}:${DB_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${DB_NAME}"

# ==============================================================================
# CACHE/SESSION STORE (Redis)
# ==============================================================================
REDIS_HOST="${REDIS_HOST:-${PRIMARY_HOST}}"
REDIS_PORT="${REDIS_PORT:-6379}"
REDIS_PASSWORD="${REDIS_PASSWORD:-redis-dev-password}"
REDIS_CONTAINER_NAME="${REDIS_CONTAINER_NAME:-code-server-redis}"
REDIS_MAXMEMORY="${REDIS_MAXMEMORY:-6gb}"
REDIS_MAXMEMORY_POLICY="${REDIS_MAXMEMORY_POLICY:-allkeys-lru}"
REDIS_APPENDONLY="${REDIS_APPENDONLY:-yes}"

# Endpoints (read-only)
REDIS_ENDPOINT="redis://${REDIS_HOST}:${REDIS_PORT}"
REDIS_TLS_ENDPOINT="rediss://${REDIS_HOST}:${REDIS_PORT}"

# ==============================================================================
# MESSAGE BROKER CONFIGURATION (Redpanda/Kafka)
# ==============================================================================
REDPANDA_BROKERS="${REDPANDA_BROKERS:-code-server-redpanda:9092}"
REDPANDA_ADMIN_BROKERS="${REDPANDA_ADMIN_BROKERS:-code-server-redpanda:9644}"
REDPANDA_SCHEMA_REGISTRY="${REDPANDA_SCHEMA_REGISTRY:-code-server-redpanda:8081}"
REDPANDA_PARTITIONS="${REDPANDA_PARTITIONS:-3}"
REDPANDA_REPLICATION_FACTOR="${REDPANDA_REPLICATION_FACTOR:-2}"
REDPANDA_CONTAINER_NAME="${REDPANDA_CONTAINER_NAME:-code-server-redpanda}"

# Kafka compatibility (for clients using kafka protocol)
KAFKA_BROKER="${KAFKA_BROKER:-${REDPANDA_BROKERS}}"
KAFKA_JMX_EXPORTER="${KAFKA_JMX_EXPORTER:-localhost:9308}"

# Endpoint (read-only)
REDPANDA_KAFKA_ENDPOINT="${REDPANDA_BROKERS}"

# ==============================================================================
# VECTOR DATABASE (Qdrant)
# ==============================================================================
QDRANT_HOST="${QDRANT_HOST:-${PRIMARY_HOST}}"
QDRANT_PORT="${QDRANT_PORT:-6333}"
QDRANT_API_KEY="${QDRANT_API_KEY:-qdrant-dev-key-12345}"
QDRANT_CONTAINER_NAME="${QDRANT_CONTAINER_NAME:-code-server-qdrant}"

# Endpoint (read-only)
QDRANT_ENDPOINT="http://${QDRANT_HOST}:${QDRANT_PORT}"

# ==============================================================================
# POLICY ENGINE (OPA)
# ==============================================================================
OPA_HOST="${OPA_HOST:-${PRIMARY_HOST}}"
OPA_PORT="${OPA_PORT:-8181}"
OPA_CONTAINER_NAME="${OPA_CONTAINER_NAME:-code-server-opa}"

# Endpoint (read-only)
OPA_ENDPOINT="http://${OPA_HOST}:${OPA_PORT}"

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================
# Prometheus
PROMETHEUS_HOST="${PROMETHEUS_HOST:-${PRIMARY_HOST}}"
PROMETHEUS_PORT="${PROMETHEUS_PORT:-9090}"
PROMETHEUS_RETENTION="${PROMETHEUS_RETENTION:-30d}"
PROMETHEUS_SCRAPE_INTERVAL="${PROMETHEUS_SCRAPE_INTERVAL:-15s}"
PROMETHEUS_CONTAINER_NAME="${PROMETHEUS_CONTAINER_NAME:-code-server-prometheus}"
PROMETHEUS_ENDPOINT="http://${PROMETHEUS_HOST}:${PROMETHEUS_PORT}"

# Grafana
GRAFANA_HOST="${GRAFANA_HOST:-${PRIMARY_HOST}}"
GRAFANA_PORT="${GRAFANA_PORT:-3000}"
GRAFANA_ADMIN_USER="${GRAFANA_ADMIN_USER:-admin}"
GRAFANA_ADMIN_PASSWORD="${GRAFANA_ADMIN_PASSWORD:-grafana_secure_2026}"
GRAFANA_SECURITY_ADMIN_USER="${GRAFANA_SECURITY_ADMIN_USER:-admin}"
GRAFANA_SECURITY_ADMIN_PASSWORD="${GRAFANA_SECURITY_ADMIN_PASSWORD:-grafana_secure_2026}"
GRAFANA_CONTAINER_NAME="${GRAFANA_CONTAINER_NAME:-code-server-grafana}"
GRAFANA_ENDPOINT="http://${GRAFANA_HOST}:${GRAFANA_PORT}"

# Loki (Log aggregation)
LOKI_HOST="${LOKI_HOST:-${PRIMARY_HOST}}"
LOKI_PORT="${LOKI_PORT:-3100}"
LOKI_RETENTION_DAYS="${LOKI_RETENTION_DAYS:-30}"
LOKI_CONTAINER_NAME="${LOKI_CONTAINER_NAME:-code-server-loki}"

# Tempo (Distributed tracing)
TEMPO_HOST="${TEMPO_HOST:-${PRIMARY_HOST}}"
TEMPO_PORT="${TEMPO_PORT:-3200}"
TEMPO_CONTAINER_NAME="${TEMPO_CONTAINER_NAME:-code-server-tempo}"

# OTel Collector
OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_EXPORTER_OTLP_ENDPOINT:-http://localhost:4317}"
OTEL_CONTAINER_NAME="${OTEL_CONTAINER_NAME:-code-server-otel-collector}"

# Alertmanager
ALERTMANAGER_HOST="${ALERTMANAGER_HOST:-${PRIMARY_HOST}}"
ALERTMANAGER_PORT="${ALERTMANAGER_PORT:-9093}"
ALERTMANAGER_SMTP_FROM="${ALERTMANAGER_SMTP_FROM:-alerts@${APEX_DOMAIN}}"
ALERTMANAGER_CONTAINER_NAME="${ALERTMANAGER_CONTAINER_NAME:-code-server-alertmanager}"

# ==============================================================================
# AI/ML SERVICES
# ==============================================================================
MEMORY_SERVICE_HOST="${MEMORY_SERVICE_HOST:-${PRIMARY_HOST}}"
MEMORY_SERVICE_PORT="${MEMORY_SERVICE_PORT:-8000}"
MEMORY_SERVICE_ENDPOINT="http://${MEMORY_SERVICE_HOST}:${MEMORY_SERVICE_PORT}"

REPUTATION_ENGINE_HOST="${REPUTATION_ENGINE_HOST:-${PRIMARY_HOST}}"
REPUTATION_ENGINE_PORT="${REPUTATION_ENGINE_PORT:-8001}"
REPUTATION_ENGINE_URL="http://${REPUTATION_ENGINE_HOST}:${REPUTATION_ENGINE_PORT}"

# ==============================================================================
# LOGGING & OBSERVABILITY CONTROL
# ==============================================================================
LOG_LEVEL="${LOG_LEVEL:-info}"
LOG_FORMAT="${LOG_FORMAT:-json}"

# ==============================================================================
# HEALTH CHECKS (Deployment Validation)
# ==============================================================================
HEALTH_CHECK_TIMEOUT="${HEALTH_CHECK_TIMEOUT:-300}"
HEALTH_CHECK_MAX_ATTEMPTS="${HEALTH_CHECK_MAX_ATTEMPTS:-30}"
HEALTH_CHECK_INTERVAL="${HEALTH_CHECK_INTERVAL:-10}"

# ==============================================================================
# DEPLOYMENT/REGISTRY CONFIGURATION
# ==============================================================================
# Container registry (for pulling/building images)
REGISTRY_URL="${REGISTRY_URL:-registry.kushnir.cloud:5000}"
REGISTRY_USERNAME="${REGISTRY_USERNAME:-docker}"
REGISTRY_PASSWORD="${REGISTRY_PASSWORD:-changeme}"

# Image versions (pinned for reproducibility)
BASE_IMAGE_PYTHON="${BASE_IMAGE_PYTHON:-python:3.11-slim}"
BASE_IMAGE_NODEJS="${BASE_IMAGE_NODEJS:-node:20-alpine}"

# ==============================================================================
# DOCKER COMPOSE CONFIGURATION
# ==============================================================================
# Compose project name (for consistent naming across multiple deploys)
COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-code-server}"

# ==============================================================================
# VARIABLE VALIDATION
# ==============================================================================
# Function to validate required variables are set
validate_required_vars() {
  local required=(
    "PRIMARY_HOST"
    "APEX_DOMAIN"
    "ADMIN_EMAIL"
    "DB_PASSWORD"
    "REDIS_PASSWORD"
    "POSTGRES_PASSWORD"
    "OAUTH2_CLIENT_SECRET"
    "OAUTH2_COOKIE_SECRET"
  )
  
  local missing=()
  for var in "${required[@]}"; do
    if [[ -z "${!var}" ]]; then
      missing+=("$var")
    fi
  done
  
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "ERROR: Missing required environment variables:" >&2
    printf '  - %s\n' "${missing[@]}" >&2
    return 1
  fi
}

# Unset the 'set -a' for cleaner exports
set +a

# Export validation function
export -f validate_required_vars
