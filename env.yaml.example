# @file        env.yaml.example
# @description Example environment specification for kushnir.cloud setup
# @version     1
# @owner       devos
#
# Portable environment definition - Local = Remote = CI = AI
# Copy to env.yaml and customize for your setup

version: "1"

# Runtime configuration
runtime:
  mode: local                    # local | remote | ci | edge
  host: localhost:3000           # For remote mode
  fallback: local                # Fallback if primary unavailable
  resource_limits:
    cpu: 4
    memory: 8Gi
    disk: 50Gi

# Services to provision
services:
  # PostgreSQL - Primary database
  - name: postgres
    image: postgres:16@sha256:a82efea989f9a26c76a38db15e1f8fa52cc3c18b8f0ab6e5e0f8e8f8e8f8e8f
    persistent: true
    ports:
      - "5432:5432"
    env:
      POSTGRES_DB: appdb
      POSTGRES_USER: app
      POSTGRES_PASSWORD: local-dev-only
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "app"]
      interval: 10s
      timeout: 5s

  # Redis - Session cache and budget tracking
  - name: redis
    image: redis:7@sha256:b0dc3368541c5837bcd39b6bb948aa8408c7ba98a9b3c9d82df3bb4833c4d99
    persistent: true
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s

  # Ollama - Local AI model hosting
  - name: ollama
    image: ollama/ollama:0.1.0
    persistent: true
    ports:
      - "11434:11434"
    volumes:
      - ollama_models:/root/.ollama
    env:
      OLLAMA_HOST: 0.0.0.0:11434
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:11434/api/status"]
      interval: 30s
      timeout: 10s

  # Loki - Log aggregation
  - name: loki
    image: grafana/loki:2.9.3
    persistent: true
    ports:
      - "3100:3100"
    volumes:
      - loki_data:/loki
    healthcheck:
      test: ["CMD", "wget", "-q", "-O-", "http://localhost:3100/ready"]
      interval: 30s
      timeout: 5s

  # Prometheus - Metrics collection
  - name: prometheus
    image: prom/prometheus:latest
    persistent: true
    ports:
      - "9090:9090"
    volumes:
      - prometheus_data:/prometheus

# AI Configuration
ai:
  model: llama3:8b              # Default model
  provider: ollama              # llama3:8b hosted locally
  fallback_chain:
    - llama3:70b                # Fall back to larger model if timeout
  constraints:
    - no_external_unless_explicit   # Don't call external APIs
    - prompt_pii_scan               # Scan prompts for sensitive data
    - log_all_interactions          # Audit all AI requests
    - sandbox_execution             # Run in isolated context

# OPA Policies to enforce
policies:
  - no_prod_without_human           # Require human approval for production changes
  - secrets_never_leave_boundary    # PII/secrets detected → block
  - full_audit_all_actions          # All changes logged
  - require_signed_commits          # Commits must be GPG signed
  - enforce_mfa                     # MFA required for remote access

# Compliance requirements
compliance:
  frameworks:
    - SOC2                          # Service Organization Control
    - NIST-800-53                   # NIST cybersecurity framework
  data_classification: internal     # This is internal (not public/confidential/restricted)

compute:
  replicas: 1
  profiles: ["ai", "tracing", "monitoring"]

data:
  postgres:
    version: "15"
    ha: false
  redis:
    version: "7"
    mode: standalone

ai:
  providers:
    - name: ollama
      enabled: true
      models: ["llama3:8b", "codellama:13b", "mistral:7b"]
    - name: openai
      enabled: false

networking:
  domain: localhost
  tls: none
