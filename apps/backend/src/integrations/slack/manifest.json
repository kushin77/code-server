{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "IDE Session Launcher",
    "description": "Launch shared IDE sessions directly from Slack",
    "background_color": "#0a0e27"
  },
  "features": {
    "slash_commands": [
      {
        "command": "/share-ide",
        "url": "https://api.kushnir.cloud/api/slack/commands/share-ide",
        "description": "Launch a temporary shared IDE session and share link in Slack",
        "usage_hint": "[optional: repository path]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://api.kushnir.cloud/api/slack/oauth/callback"
    ],
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "users:read",
        "team:read",
        "app_mentions:read",
        "reactions:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "socket_mode_request_url_verification_enabled": true,
    "is_hosted": false
  }
}
