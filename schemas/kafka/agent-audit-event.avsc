{
  "type": "record",
  "name": "AgentAuditEvent",
  "namespace": "com.kushnircloud.events",
  "doc": "Complete audit trail for every agent action with full context and outcome",
  "fields": [
    {
      "name": "event_id",
      "type": "string",
      "doc": "Unique event identifier (UUID)"
    },
    {
      "name": "timestamp",
      "type": "long",
      "doc": "Event timestamp in milliseconds since epoch"
    },
    {
      "name": "agent_id",
      "type": "string",
      "doc": "Unique agent identifier"
    },
    {
      "name": "agent_type",
      "type": {
        "type": "enum",
        "name": "AgentType",
        "symbols": ["copilot", "claude", "gpt", "custom", "system"]
      },
      "doc": "Type of agent that performed the action"
    },
    {
      "name": "action",
      "type": "string",
      "doc": "Action performed (e.g., 'create_file', 'run_terminal', 'search_code')"
    },
    {
      "name": "context",
      "type": {
        "type": "record",
        "name": "ActionContext",
        "fields": [
          {
            "name": "user_id",
            "type": ["null", "string"],
            "default": null,
            "doc": "User who initiated the action"
          },
          {
            "name": "session_id",
            "type": ["null", "string"],
            "default": null,
            "doc": "VS Code session identifier"
          },
          {
            "name": "workspace",
            "type": ["null", "string"],
            "default": null,
            "doc": "Workspace/project context"
          },
          {
            "name": "issue_number",
            "type": ["null", "int"],
            "default": null,
            "doc": "Related GitHub issue number"
          }
        ]
      },
      "doc": "Context information for the action"
    },
    {
      "name": "parameters",
      "type": {
        "type": "map",
        "values": "string"
      },
      "doc": "Action parameters (sanitized, no secrets)"
    },
    {
      "name": "outcome",
      "type": {
        "type": "enum",
        "name": "ActionOutcome",
        "symbols": ["success", "failure", "partial", "cancelled", "timeout"]
      },
      "doc": "Result of the action"
    },
    {
      "name": "duration_ms",
      "type": ["null", "long"],
      "default": null,
      "doc": "Action duration in milliseconds"
    },
    {
      "name": "error_message",
      "type": ["null", "string"],
      "default": null,
      "doc": "Error message if action failed"
    },
    {
      "name": "metadata",
      "type": {
        "type": "map",
        "values": "string"
      },
      "doc": "Additional metadata (file paths, line numbers, etc.)"
    }
  ]
}