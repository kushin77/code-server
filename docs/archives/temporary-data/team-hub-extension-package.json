{
  "name": "team-hub",
  "displayName": "Team Hub - Real-Time Collaboration for code-server",
  "description": "Real-time team collaboration with presence awareness, file sharing, and integrated communication via Matrix",
  "version": "0.1.0",
  "author": "Platform Team",
  "publisher": "kushnir",
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kushin77/code-server"
  },
  "bugs": {
    "url": "https://github.com/kushin77/code-server/issues"
  },
  "categories": [
    "Collaboration",
    "Other"
  ],
  "keywords": [
    "collaboration",
    "matrix",
    "presence",
    "team",
    "real-time"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:teamHub.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "team-hub-explorer",
          "title": "Team Hub",
          "icon": "media/team-hub-icon.svg"
        }
      ]
    },
    "views": {
      "team-hub-explorer": [
        {
          "id": "teamHub.sidebar",
          "name": "Team Presence",
          "type": "webview"
        },
        {
          "id": "teamHub.activity",
          "name": "Team Activity",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "teamHub.mentionUser",
        "title": "Mention User in Matrix",
        "category": "Team Hub"
      },
      {
        "command": "teamHub.startMeet",
        "title": "Start Google Meet with Selected Users",
        "category": "Team Hub"
      },
      {
        "command": "teamHub.goToUserFile",
        "title": "Go to File Being Edited by User",
        "category": "Team Hub"
      },
      {
        "command": "teamHub.refreshPresence",
        "title": "Refresh Presence Information",
        "category": "Team Hub"
      },
      {
        "command": "teamHub.settings",
        "title": "Team Hub Settings",
        "category": "Team Hub"
      }
    ],
    "keybindings": [
      {
        "command": "teamHub.mentionUser",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus"
      },
      {
        "command": "teamHub.startMeet",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      }
    ],
    "configuration": {
      "title": "Team Hub",
      "properties": {
        "teamHub.matrixHomeserver": {
          "type": "string",
          "default": "https://matrix.kushnir.cloud",
          "description": "Matrix homeserver URL"
        },
        "teamHub.presenceSidecarUrl": {
          "type": "string",
          "default": "ws://presence-sidecar:9000",
          "description": "WebSocket URL for presence sidecar"
        },
        "teamHub.enableAutoPresence": {
          "type": "boolean",
          "default": true,
          "description": "Automatically update presence when editing"
        },
        "teamHub.enableGoogleMeet": {
          "type": "boolean",
          "default": true,
          "description": "Enable Google Meet integration"
        },
        "teamHub.presenceUpdateInterval": {
          "type": "number",
          "default": 5000,
          "description": "Presence update interval in milliseconds",
          "minimum": 1000,
          "maximum": 60000
        },
        "teamHub.showAvatars": {
          "type": "boolean",
          "default": true,
          "description": "Show user avatars in sidebar"
        },
        "teamHub.highlightSameFile": {
          "type": "boolean",
          "default": true,
          "description": "Highlight users editing the same file"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "build": "npm run lint && npm run compile && npm run package"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.4.5",
    "@types/vscode": "^1.84.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "glob": "^10.3.3",
    "mocha": "^10.2.0",
    "typescript": "^5.1.6",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "matrix-js-sdk": "^28.0.0",
    "ws": "^8.14.2"
  }
}
