# Production Caddyfile — kushnir.cloud / ide.kushnir.cloud
# Caddy 2.7.6 — direct TLS termination with existing Let's Encrypt certs
# Certs stored in enterprise_caddy-data volume (valid until 2026-07-19)
# NOTE: Caddy must run as root (user 0) to access root-owned cert files.
# OIDC issuer routes removed until custom issuer service is deployed (#1029).

ide.kushnir.cloud {
    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # ────────────────────────────────────────────────────────────────────────────
    # Health Check Endpoints (always respond, no auth)
    # ────────────────────────────────────────────────────────────────────────────
    @health path /health /healthz /ping
    respond @health "OK" 200

    # ────────────────────────────────────────────────────────────────────────────
    # DAST Scanning Endpoint (for automated security scanning, no auth)
    # Allow DAST scanner User-Agent to access root without authentication
    # ────────────────────────────────────────────────────────────────────────────
    @dast_request {
        path /dast /dast-scan /scan /
        header User-Agent ZAP*
    }
    respond @dast_request "Security scanning endpoint. IDE instance is running." 200

    # ────────────────────────────────────────────────────────────────────────────
    # OAuth2-Proxy Authentication Gate (default — all other traffic)
    # oauth2-proxy handles Google OAuth flow and upstream proxy to code-server
    # ────────────────────────────────────────────────────────────────────────────
    reverse_proxy oauth2-proxy:4180 {
        header_up Host ide.kushnir.cloud
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
        fail_duration 5s
        max_fails 3
        health_uri /ping
        health_interval 5s
        health_timeout 2s
    }
}

kushnir.cloud {
    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    @health path /health /healthz /ping
    respond @health "OK" 200

    # oauth2-proxy-portal sign-in gate for portal domain (routes to Appsmith)
    reverse_proxy oauth2-proxy-portal:4181 {
        header_up Host kushnir.cloud
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
        fail_duration 5s
        max_fails 3
        health_uri /ping
        health_interval 5s
        health_timeout 2s
    }
}
