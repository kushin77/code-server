# ============================================================================
# .env/_common/defaults - BASE CONFIGURATION DEFAULTS (SSOT Foundation)
# Single Source of Truth for all shared environment variables
# 
# All application and infrastructure configuration variables are defined here.
# Environment-specific overrides are in .env/private/ and .env/air-gapped/
#
# CONSOLIDATION STRATEGY (Phase 3):
# - .env/_common/defaults = Shared values for all environments (this file - SSOT)
# - .env/private/ = Private environment-specific overrides
# - .env/air-gapped/ = Air-gapped environment-specific overrides
#
# LOAD ORDER (priority, highest to lowest):
#   1. .env/_common/defaults (this file - defaults for all environments)
#   2. .env/private/ OR .env/air-gapped/ (environment-specific overrides)
#
# USAGE: Scripts should source variables in this order:
#   source .env/_common/defaults
#   [ -f .env/private/overrides ] && source .env/private/overrides
#   # OR
#   [ -f .env/air-gapped/overrides ] && source .env/air-gapped/overrides
#
# Terraform consolidation: See terraform/environments/_common/README.md
# Date: April 30, 2026
# ============================================================================

# ============================================================================
# SECTION 1: CORE DOMAIN & IDENTITY CONFIGURATION (SSOT)
# ============================================================================
# Primary domain for all services (SOURCE OF TRUTH)
export APEX_DOMAIN=${APEX_DOMAIN:-kushnir.cloud}

# Domain aliases for specific services (derived from APEX_DOMAIN)
export AUTH_DOMAIN=${AUTH_DOMAIN:-auth.${APEX_DOMAIN}}
export APPSMITH_DOMAIN=${APPSMITH_DOMAIN:-${APEX_DOMAIN}}
export CODE_SERVER_DOMAIN=${CODE_SERVER_DOMAIN:-${APEX_DOMAIN}}
export IDE_DOMAIN=${IDE_DOMAIN:-ide.${APEX_DOMAIN}}
export API_DOMAIN=${API_DOMAIN:-api.${APEX_DOMAIN}}
export REGISTRY_DOMAIN=${REGISTRY_DOMAIN:-registry.${APEX_DOMAIN}}

# TLS/Certificate configuration
export TLS_EMAIL=${TLS_EMAIL:-admin@${APEX_DOMAIN}}
export ADMIN_EMAIL=${ADMIN_EMAIL:-admin@kushnir.cloud}

# ============================================================================
# SECTION 2: API & PROTOCOL CONFIGURATION (SSOT)
# ============================================================================
export API_PROTOCOL=${API_PROTOCOL:-http}
export API_HOST=${API_HOST:-192.168.168.31}
export API_PORT=${API_PORT:-8080}
export API_ENDPOINT=${API_ENDPOINT:-${API_PROTOCOL}://${API_HOST}:${API_PORT}}
export API_HEALTH_ENDPOINT=${API_HEALTH_ENDPOINT:-${API_ENDPOINT}/health}
export API_OAUTH_CALLBACK=${API_OAUTH_CALLBACK:-${API_ENDPOINT}/oauth/callback}

# ============================================================================
# SECTION 3: CLUSTER & HIGH AVAILABILITY CONFIGURATION (SSOT)
# ============================================================================
export CLUSTER_VIP=${CLUSTER_VIP:-192.168.168.250}
export CLUSTER_HOST_1=${CLUSTER_HOST_1:-192.168.168.31}
export CLUSTER_HOST_2=${CLUSTER_HOST_2:-192.168.168.42}
export PRIMARY_HOST=${PRIMARY_HOST:-192.168.168.31}
export REPLICA_HOST=${REPLICA_HOST:-192.168.168.42}

# Deployment mode: primary, replica, or private
export DEPLOYMENT_MODE=${DEPLOYMENT_MODE:-private}
export REPLICA_ENABLED=${REPLICA_ENABLED:-true}
export REPLICATION_MODE=${REPLICATION_MODE:-primary}

# ============================================================================
# SECTION 4: DATABASE CONFIGURATION (SSOT)
# ============================================================================
# PostgreSQL primary configuration
export DATABASE_HOST=${DATABASE_HOST:-code-server-postgres}
export DATABASE_PORT=${DATABASE_PORT:-5432}
