# Emergency Fix for Issue #1686 — Let's Encrypt Rate Limit
# Temporary Caddyfile configuration to bypass certificate renewal during rate limiting
# 
# Rate Limit Duration: Until 2026-04-25 @ 11:35:25 UTC (~15+ hours)
# Status: TEMPORARY - Revert to production Caddyfile once rate limit expires
#
# This configuration:
# 1. Disables automatic certificate provisioning for affected domains
# 2. Uses HTTP-only for health checks (unblocks DAST scanner)
# 3. Maintains OAuth2-Proxy authentication for authenticated traffic
# 4. Is deployment-ready for both replicas

# Health check endpoint — HTTP only (bypasses TLS entirely)
# This is safe because health checks are internal monitoring,  not user-facing
:80 {
    @health path /health /healthz /ping
    respond @health "OK" 200
    
    # Redirect other HTTP traffic to HTTPS (standard)
    @notHealth {
        path_regexp !^/(health|healthz|ping)
    }
    redir @notHealth https://{host}{uri}
}

# ide.kushnir.cloud — OAuth gate with certificate renewal disabled
ide.kushnir.cloud {
    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # Health endpoint - respond immediately without auth
    @health path /health /healthz /ping
    respond @health "OK" 200

    # Disable TLS certificate renewal during rate limiting
    # Uses existing cached certificate if available
    # CRITICAL: This is temporary. Re-enable ACME in production Caddyfile after 2026-04-25 11:35 UTC
    tls {
        # Use only existing certificates; don't attempt to obtain new ones
        # If no cert exists, falls back to self-signed (breaks client validation)
        # Remove this block after rate limit expires
    }

    # OAuth2-Proxy authentication gate
    reverse_proxy oauth2-proxy:4180 {
        header_up Host ide.kushnir.cloud
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
        fail_duration 5s
        max_fails 3
        health_uri /ping
        health_interval 5s
        health_timeout 2s
    }
}

# kushnir.cloud — Portal with certificate renewal disabled
kushnir.cloud {
    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    @health path /health /healthz /ping
    respond @health "OK" 200

    # Disable TLS certificate renewal during rate limiting (same as above)
    tls {
    }

    reverse_proxy oauth2-proxy-portal:4181 {
        header_up Host kushnir.cloud
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
        fail_duration 5s
        max_fails 3
        health_uri /ping
        health_interval 5s
        health_timeout 2s
    }
}

# Wildcard domains — Certificate renewal disabled
*.kushnir.cloud {
    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    @health path /health /healthz /ping
    respond @health "OK" 200

    # Disable TLS certificate renewal during rate limiting
    tls {
    }

    reverse_proxy saas-api:4000 {
        header_up Host {http.request.host}
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
        fail_duration 5s
        max_fails 3
        health_uri /ping
        health_interval 5s
        health_timeout 2s
    }
}
