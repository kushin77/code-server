{
  "name": "kc-github-oauth",
  "displayName": "KC GitHub OAuth Integration",
  "description": "User-scoped GitHub OAuth2 integration for KC IDE. Each user authenticates with their own GitHub account for personalized access to repos, issues, and PRs.",
  "version": "1.0.0",
  "publisher": "kushnir",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "github",
    "oauth",
    "authentication",
    "session",
    "user-scoped"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kcGithubOAuth.authenticate",
        "title": "KC GitHub: Authenticate",
        "category": "GitHub"
      },
      {
        "command": "kcGithubOAuth.logout",
        "title": "KC GitHub: Logout",
        "category": "GitHub"
      },
      {
        "command": "kcGithubOAuth.showSession",
        "title": "KC GitHub: Show Current Session",
        "category": "GitHub"
      },
      {
        "command": "kcGithubOAuth.openUserRepos",
        "title": "KC GitHub: Open My Repositories",
        "category": "GitHub"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kcGithub-container",
          "title": "GitHub",
          "icon": "media/github-icon.svg"
        }
      ]
    },
    "views": {
      "kcGithub-container": [
        {
          "id": "kcGithubOAuth.session",
          "name": "User Session",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "package": "vsce package",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "esbuild": "^0.19.0"
  },
  "dependencies": {}
}
