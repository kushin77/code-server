# Passwordless sudo for akushnir user - enables automated deployment operations
# Generated: 2026-04-23
# Issue: #1636 - Configure passwordless sudo for deployment operations

# Allow akushnir to run all commands without password
# This is required for unattended deployment operations, health checks, and failover automation
akushnir ALL=(ALL) NOPASSWD: ALL

# SECURITY NOTE:
# This grants unrestricted sudo access without password. For production hardening,
# restrict to specific commands as needed. Examples:
#
# akushnir ALL=(ALL) NOPASSWD: /usr/bin/docker, /usr/bin/docker-compose, /bin/systemctl, \
#     /sbin/reboot, /sbin/poweroff, /sbin/shutdown, \
#     /bin/journalctl, /usr/bin/systemctl, /usr/bin/cgroups-ls
#
# This entry enables:
# - Automated failover and reboot operations
# - Docker compose restart without prompts
# - Systemd operations (restart, status, logs)
# - Network reconfiguration (sudo iptables, sudo ip commands)
# - Package management via sudo apt/dnf
