        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Server
    }

    @health path /health /healthz /ping
    respond @health "OK" 200

    @no_portal_access {
        not path /health /healthz /ping /oauth2 /oauth2/*
        not header Cookie *_oauth2_proxy_portal=*
    }
    redir @no_portal_access https://{$PORTAL_DOMAIN:kushnir.cloud}/oauth2/start?rd=https://alertmanager.{$DOMAIN:kushnir.cloud}/ 302

