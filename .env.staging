# .env.staging — Staging Environment Overrides
# Populate secrets from GSM/Vault before a real staging deployment.

DEPLOYMENT_ENV=staging
APEX_DOMAIN=staging.kushnir.cloud
DOMAIN=staging.kushnir.cloud
PRIMARY_HOST_IP=192.168.168.32
PRIMARY_HOST=192.168.168.32
DEPLOY_HOST=192.168.168.32
STANDBY_HOST_IP=192.168.168.33
SSH_PORT=22
DOCKER_SOCKET=ssh://akushnir@192.168.168.32

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URL=https://staging.kushnir.cloud/oauth2/callback
OAUTH2_IDE_GOOGLE_CLIENT_ID=
OAUTH2_IDE_GOOGLE_CLIENT_SECRET=
OAUTH2_PORTAL_GOOGLE_CLIENT_ID=
OAUTH2_PORTAL_GOOGLE_CLIENT_SECRET=
OAUTH2_PROXY_IDE_REDIRECT_URL=https://ide.staging.kushnir.cloud/oauth2/callback
OAUTH2_PROXY_PORTAL_REDIRECT_URL=https://staging.kushnir.cloud/oauth2/callback
OAUTH2_PROXY_IDE_EMAIL_DOMAINS=*
OAUTH2_PROXY_PORTAL_EMAIL_DOMAINS=*
OAUTH2_PROXY_COOKIE_SECRET=
GITHUB_TOKEN=
SENTRY_ORG_SLUG=kushnir-cloud
SLACK_BOT_TOKEN=
REGISTRY_AUTH_TOKEN_SECRET=
IDE_SESSION_LB_SECRET=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=code_server
POSTGRES_USER=code_server
POSTGRES_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

TLS_CERT_FILE=
TLS_KEY_FILE=
SOPS_AGE_KEY_FILE=
SOPS_ENABLED=false

LOG_LEVEL=info
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_ENABLED=false
JAEGER_ENDPOINT=http://jaeger:16686
LOKI_HOST=loki
LOKI_PORT=3100

NAS_HOST=192.168.168.56
NAS_MOUNT_POINT=/mnt/nas
NAS_EXPORT_PATH=/export
NFS_VERSION=nfs4

CODE_SERVER_PORT=8080
CODE_SERVER_BIND=127.0.0.1
MINIO_ENDPOINT=s3.staging.localhost
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
OLLAMA_ENABLED=false
OLLAMA_VERSION=0.1.27
