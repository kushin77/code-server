# Caddyfile - API Gateway with TLS/HTTPS
# Code-Server Enterprise Platform - Phase 14A Production Hardening
# Configuration: Reverse proxy with TLS, security headers, rate limiting

# Global settings
{
  admin 0.0.0.0:2019
}

# HTTP redirect (redirect all HTTP to HTTPS)
:80 {
  redir https://{host}{uri} permanent
}

# HTTPS configuration with security hardening
:443 {
  # TLS certificate configuration
  # For development/testing: self-signed certificates at /certs/
  # For production: Configure Let's Encrypt ACME
  
  tls /data/cert.pem /data/private.key {
    protocols tls1.2 tls1.3
    ciphers TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
  }

  # Security Headers
  header / {
    # Prevent MIME type sniffing
    X-Content-Type-Options "nosniff"
    
    # Enable XSS protection
    X-XSS-Protection "1; mode=block"
    
    # Prevent clickjacking
    X-Frame-Options "SAMEORIGIN"
    
    # Content Security Policy
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'"
    
    # HSTS (HTTP Strict-Transport-Security)
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Referrer Policy
    Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy
    Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  }

  # Application Service Routes - Phase 13 Core Services
  
  # API Gateway Entry Point
  route /api/v1* {
    uri strip_prefix /api/v1
    reverse_proxy code-server-api-service:8000 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto https
    }
  }

  # User Service
