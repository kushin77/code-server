# Canonical service/container names and endpoints for deployment scripts.
# All services use code-server- prefix for Docker Compose container naming.
# All endpoints default to localhost for local development; set TF_VAR_* for remote deployment.

# Container Names
export POSTGRES_CONTAINER_NAME="${POSTGRES_CONTAINER_NAME:-code-server-postgres}"
export REDIS_CONTAINER_NAME="${REDIS_CONTAINER_NAME:-code-server-redis}"
export REDPANDA_CONTAINER_NAME="${REDPANDA_CONTAINER_NAME:-code-server-redpanda}"
export REDPANDA_CONSOLE_CONTAINER_NAME="${REDPANDA_CONSOLE_CONTAINER_NAME:-code-server-redpanda-console}"
export QDRANT_CONTAINER_NAME="${QDRANT_CONTAINER_NAME:-code-server-qdrant}"

# Service Endpoints (host:port)
export POSTGRES_ENDPOINT="${POSTGRES_ENDPOINT:-localhost:5432}"
export REDIS_ENDPOINT="${REDIS_ENDPOINT:-localhost:6379}"
export REDIS_TLS_ENDPOINT="${REDIS_TLS_ENDPOINT:-localhost:6380}"
export QDRANT_ENDPOINT="${QDRANT_ENDPOINT:-localhost:6333}"
export REDPANDA_KAFKA_ENDPOINT="${REDPANDA_KAFKA_ENDPOINT:-localhost:9092}"
export REDPANDA_SCHEMA_REGISTRY_ENDPOINT="${REDPANDA_SCHEMA_REGISTRY_ENDPOINT:-localhost:8081}"
export REDPANDA_ADMIN_ENDPOINT="${REDPANDA_ADMIN_ENDPOINT:-localhost:9644}"
export OPA_ENDPOINT="${OPA_ENDPOINT:-localhost:8181}"