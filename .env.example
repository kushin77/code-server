# Example .env — Kushnir.cloud Production Configuration
# Copy this as .env on production replicas and populate with actual values

# ═══════════════════════════════════════════════════════════════════════════════
# Docker Compose Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# Enable portal services (Appsmith + oauth2-proxy-portal)
# REQUIRED for kushnir.cloud (portal) routing to work
COMPOSE_PROFILES=portal

# ═══════════════════════════════════════════════════════════════════════════════
# Domain Configuration
# ═══════════════════════════════════════════════════════════════════════════════

APEX_DOMAIN=kushnir.cloud
IDE_DOMAIN=ide.kushnir.cloud

# ═══════════════════════════════════════════════════════════════════════════════
# OAuth2 & Authentication
# ═══════════════════════════════════════════════════════════════════════════════

# Google OAuth2 credentials (from Google Cloud Console)
# Store actual values in Google Secret Manager, use <vault:KEY_NAME> placeholders here
GOOGLE_CLIENT_ID=<vault:google_oauth_client_id>
GOOGLE_CLIENT_SECRET=<vault:google_oauth_client_secret>

# OAuth2-Proxy session cookie secret (min 32 characters, random)
# Generate: openssl rand -hex 32
OAUTH2_PROXY_COOKIE_SECRET=<vault:oauth2_proxy_cookie_secret>

# OAuth2 redirect URLs (automatically derived from APEX_DOMAIN and IDE_DOMAIN)
OAUTH2_PROXY_IDE_REDIRECT_URL=https://${IDE_DOMAIN}/oauth2/callback
OAUTH2_PROXY_PORTAL_REDIRECT_URL=https://${APEX_DOMAIN}/oauth2/callback

# ═══════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════════════════

POSTGRES_USER=postgres
POSTGRES_PASSWORD=<vault:postgres_admin_password>
POSTGRES_DB=codeserver

# ═══════════════════════════════════════════════════════════════════════════════
# Redis Configuration
# ═══════════════════════════════════════════════════════════════════════════════

REDIS_PASSWORD=<vault:redis_password>

# ═══════════════════════════════════════════════════════════════════════════════
# Appsmith Portal Configuration
# ═══════════════════════════════════════════════════════════════════════════════

APPSMITH_SIGNUP_DISABLED=true
APPSMITH_FORM_LOGIN_DISABLED=true
APPSMITH_OAUTH2_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
APPSMITH_OAUTH2_GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
APPSMITH_BASE_URL=https://${APEX_DOMAIN}
APPSMITH_CUSTOM_DOMAIN=${APEX_DOMAIN}

# ═══════════════════════════════════════════════════════════════════════════════
# Code-Server IDE Configuration
# ═══════════════════════════════════════════════════════════════════════════════

CODE_SERVER_PASSWORD=<vault:code_server_password>

# ═══════════════════════════════════════════════════════════════════════════════
# Notes
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Replace <vault:KEY_NAME> placeholders with actual values from Google Secret Manager
# 2. Never commit this file with real secrets — use Secret Manager for production
# 3. COMPOSE_PROFILES=portal MUST be set for portal services to start automatically
# 4. After updating this file, redeploy: docker compose pull && docker compose up -d
