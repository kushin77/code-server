# P3-1676 SSO Validation Test Environment Configuration
# Usage: source .env.test before running playwright tests

# URLs
export TEST_BASE_URL=https://ide.kushnir.cloud
export PORTAL_BASE_URL=https://kushnir.cloud
export IDE_BASE_URL=https://ide.kushnir.cloud
export API_ENDPOINT=https://kushnir.cloud

# Test Configuration
export PLAYWRIGHT_TIMEOUT=30000
export PLAYWRIGHT_RETRIES=3
export PLAYWRIGHT_WORKERS=1
export CI=true

# Feature Flags
export REQUIRE_VPN=0
export REQUIRE_SINGLE_LOGIN=1
export REQUIRE_QA_STORAGE_STATE=0

# Test Output
export PLAYWRIGHT_HTML_REPORT=./playwright-report
export PLAYWRIGHT_JSON_REPORT=./test-results/results.json
export PLAYWRIGHT_JUNIT_REPORT=./test-results/junit.xml

# Logging
export DEBUG=pw:api
export PWDEBUG=0

# Verbose output
export VERBOSE=1

# Node environment
export NODE_ENV=test
