{
  "name": "kc-branding",
  "displayName": "KC IDE Branding",
  "description": "Sovereign KC IDE branding package — custom welcome page, themes, and workspace configuration.",
  "version": "1.0.0",
  "publisher": "kushnir",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "branding",
    "workspace",
    "kc-ide",
    "kushnir.cloud"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kcBranding.openWelcome",
        "title": "KC IDE: Open Welcome Page",
        "category": "KC IDE"
      },
      {
        "command": "kcBranding.applyWorkspaceDefaults",
        "title": "KC IDE: Apply Workspace Defaults",
        "category": "KC IDE"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "kcBranding.welcome",
          "name": "KC IDE Welcome",
          "when": "workspaceFolderCount == 0"
        }
      ]
    },
    "themes": [
      {
        "label": "KC IDE Light",
        "uiTheme": "vs",
        "path": "./themes/kc-light.json"
      },
      {
        "label": "KC IDE Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/kc-dark.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc",
    "watch": "tsc -w",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "package": "vsce package",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "esbuild": "^0.19.0"
  },
  "dependencies": {}
}
