#!/usr/bin/env bash
# @file        .env.integration-services.example
# @module      deployment/configuration
# @description Environment variables required to activate IaC/immutable/idempotent integration services
#
# Copy this file to .env or source it before deploying:
#   cp .env.integration-services.example .env.integration-services
#   source .env.integration-services
#   docker-compose up -d sentry-integration-api slack-slash-commands-api

# ════════════════════════════════════════════════════════════════════════════
# Sentry Integration API Configuration
# IaC: All secrets loaded from environment (no hardcoded defaults)
# Immutable: Error snapshots frozen via Object.freeze()
# Idempotent: x-idempotency-key support for safe retry
# ════════════════════════════════════════════════════════════════════════════

# Sentry API token for error fetching and management
# Get from: https://sentry.io/settings/account/api/auth-tokens/
# Required for: Fetching errors, posting comments, updating issue status
export SENTRY_AUTH_TOKEN="${SENTRY_AUTH_TOKEN:?SENTRY_AUTH_TOKEN must be set - get from https://sentry.io/settings/account/api/auth-tokens/}"

# Sentry organization slug (visible in Sentry dashboard URL)
# Example: https://sentry.io/organizations/my-org/ → my-org
export SENTRY_ORG_SLUG="${SENTRY_ORG_SLUG:?SENTRY_ORG_SLUG must be set}"

# Sentry project slug for code-server errors
# Default: code-server (can be overridden if using different project)
export SENTRY_PROJECT_SLUG="${SENTRY_PROJECT_SLUG:-code-server}"

# GitHub token for AI-powered fix suggestions
# Get from: https://github.com/settings/tokens
# Required scope: repo (for code analysis via GitHub API)
export GITHUB_TOKEN="${GITHUB_TOKEN:?GITHUB_TOKEN must be set - get from https://github.com/settings/tokens}"

# ════════════════════════════════════════════════════════════════════════════
# Slack Integration API Configuration
# IaC: All secrets loaded from environment (no hardcoded defaults)
# Immutable: Command responses frozen via Object.freeze()
# Idempotent: trigger_id-based deduplication for safe command handling
# ════════════════════════════════════════════════════════════════════════════

# Slack app signing secret for request validation
# Get from: Slack App Settings → Basic Information → Signing Secret
# Required for: Verifying webhook authenticity from Slack
export SLACK_SIGNING_SECRET="${SLACK_SIGNING_SECRET:?SLACK_SIGNING_SECRET must be set - get from Slack app settings}"

# Slack bot token for API operations
# Get from: Slack App Settings → OAuth & Permissions → Bot User OAuth Token
# Required scope: chat:write, users:read, files:read, channels:read
export SLACK_BOT_TOKEN="${SLACK_BOT_TOKEN:?SLACK_BOT_TOKEN must be set - get from https://api.slack.com/apps}"

# Workspace URL for Slack integration context
# Default: https://ide.kushnir.cloud (production IDE server)
export WORKSPACE_URL="${WORKSPACE_URL:-https://ide.kushnir.cloud}"

# ════════════════════════════════════════════════════════════════════════════
# Service Configuration
# ════════════════════════════════════════════════════════════════════════════

# Sentry API port (exposed on docker network)
export SENTRY_API_PORT="${SENTRY_API_PORT:-9095}"

# Slack API port (exposed on docker network)
export SLACK_API_PORT="${SLACK_API_PORT:-9096}"

# ════════════════════════════════════════════════════════════════════════════
# IaC Compliance Verification
# ════════════════════════════════════════════════════════════════════════════

# Verify all required env vars are set before deployment
verify_integration_env() {
    local missing=0
    
    for var in SENTRY_AUTH_TOKEN SENTRY_ORG_SLUG GITHUB_TOKEN SLACK_SIGNING_SECRET SLACK_BOT_TOKEN; do
        if [[ -z "${!var}" ]]; then
            echo "ERROR: $var is not set"
            missing=$((missing + 1))
        fi
    done
    
    if [[ $missing -gt 0 ]]; then
        echo "ERROR: $missing required environment variables are missing"
        return 1
    fi
    
    echo "✓ All required environment variables are set"
    return 0
}

# Export function for use in deployment scripts
export -f verify_integration_env
