################################################################################
# Epic #1536 Phase 3: DNS-Based Service Discovery Configuration
# @governance SSOT for all Kubernetes DNS resolution & service discovery
# @compliance GOV-002: Immutable, environment-driven, no hardcoding
# @date 2026-04-26
################################################################################

# ============================================================================
# PRIMARY DNS ZONE CONFIGURATION
# ============================================================================

# Apex domain (SSOT for all DNS)
export DNS_ZONE="${DNS_ZONE:-kushnir.cloud}"

# Primary & Secondary nameservers (for zone delegation)
export DNS_PRIMARY_NS="${DNS_PRIMARY_NS:-ns1.kushnir.cloud}"
export DNS_SECONDARY_NS="${DNS_PRIMARY_NS:-ns2.kushnir.cloud}"

# ============================================================================
# KUBERNETES SERVICE DNS CONFIGURATION
# ============================================================================
# Note: Kubernetes DNS automatically resolves services via Coredns
# Format: {service}.{namespace}.svc.cluster.local
# Example: postgres.default.svc.cluster.local

# Kubernetes cluster DNS suffix
export K8S_DNS_SUFFIX="${K8S_DNS_SUFFIX:-svc.cluster.local}"

# Default namespace for non-namespaced services
export K8S_DEFAULT_NAMESPACE="${K8S_DEFAULT_NAMESPACE:-default}"

# Observability namespace (where monitoring services run)
export K8S_OBSERVABILITY_NS="${K8S_OBSERVABILITY_NS:-observability}"

# Application namespace (where app microservices run)
export K8S_APP_NS="${K8S_APP_NS:-applications}"

# ============================================================================
# EXTERNAL SERVICE DISCOVERY (Outside Kubernetes)
# ============================================================================
# For on-prem services that are NOT yet migrated to Kubernetes

# PostgreSQL (on-prem or RDS)
export POSTGRES_HOST="${POSTGRES_HOST:-postgres.${DNS_ZONE}}"
export POSTGRES_PORT="${POSTGRES_PORT:-5432}"
export POSTGRES_FQDN="${POSTGRES_HOST}:${POSTGRES_PORT}"

# Redis cache (on-prem or managed)
export REDIS_HOST="${REDIS_HOST:-redis.${DNS_ZONE}}"
export REDIS_PORT="${REDIS_PORT:-6379}"
export REDIS_FQDN="${REDIS_HOST}:${REDIS_PORT}"

# Kafka brokers (internal to Kubernetes once migrated)
export KAFKA_BROKERS="${KAFKA_BROKERS:-kafka-0.${DNS_ZONE}:9092,kafka-1.${DNS_ZONE}:9092,kafka-2.${DNS_ZONE}:9092}"

# Ollama LLM service (external deployment)
export OLLAMA_HOST="${OLLAMA_HOST:-ollama.${DNS_ZONE}}"
export OLLAMA_PORT="${OLLAMA_PORT:-11434}"
export OLLAMA_FQDN="${OLLAMA_HOST}:${OLLAMA_PORT}"

# ============================================================================
# APPLICATION ENDPOINTS (External to Kubernetes)
# ============================================================================
# These are exposed via Caddy/Ingress Controller at VRRP VIP

# Apex domain (landing portal)
export APEX_DOMAIN="${APEX_DOMAIN:-${DNS_ZONE}}"

# IDE endpoint
export IDE_DOMAIN="${IDE_DOMAIN:-ide.${DNS_ZONE}}"

# API gateway
export API_DOMAIN="${API_DOMAIN:-api.${DNS_ZONE}}"

# OAuth2 proxy authentication endpoint
export AUTH_DOMAIN="${AUTH_DOMAIN:-auth.${DNS_ZONE}}"

# Admin panel (separate auth scope)
export ADMIN_DOMAIN="${ADMIN_DOMAIN:-admin.${DNS_ZONE}}"

# API documentation
export API_DOCS_DOMAIN="${API_DOCS_DOMAIN:-docs.${DNS_ZONE}}"

# ============================================================================
# VRRP VIRTUAL IP & INGRESS CONFIGURATION
# ============================================================================
# Virtual IP where Caddy/Ingress Controller listens

export ONPREM_VRRP_VIP="${ONPREM_VRRP_VIP:-192.168.168.100}"
export VRRP_HOSTNAME="${VRRP_HOSTNAME:-vrrp.${DNS_ZONE}}"

# Ingress controller service (inside Kubernetes)
export INGRESS_CONTROLLER_SERVICE="${INGRESS_CONTROLLER_SERVICE:-ingress-nginx.ingress-nginx.${K8S_DNS_SUFFIX}}"

# ============================================================================
# INTERNAL SERVICE DISCOVERY (Inside Kubernetes)
# ============================================================================
# These are automatically resolved via CoreDNS inside K8s cluster

# PostgreSQL StatefulSet (inside K8s)
export POSTGRES_K8S_HOST="${POSTGRES_K8S_HOST:-postgres.${K8S_APP_NS}.${K8S_DNS_SUFFIX}}"

# Redis deployment (inside K8s)
export REDIS_K8S_HOST="${REDIS_K8S_HOST:-redis.${K8S_APP_NS}.${K8S_DNS_SUFFIX}}"

# Kafka brokers (inside K8s - headless service)
export KAFKA_K8S_BROKERS="${KAFKA_K8S_BROKERS:-kafka-0.kafka-headless.${K8S_APP_NS}.${K8S_DNS_SUFFIX}:9092,kafka-1.kafka-headless.${K8S_APP_NS}.${K8S_DNS_SUFFIX}:9092}"

# Event bus (Kafka/Redpanda)
export EVENT_BUS_HOST="${EVENT_BUS_HOST:-kafka.${K8S_APP_NS}.${K8S_DNS_SUFFIX}}"

# Prometheus (metrics collection)
export PROMETHEUS_HOST="${PROMETHEUS_HOST:-prometheus.${K8S_OBSERVABILITY_NS}.${K8S_DNS_SUFFIX}}"

# Grafana (dashboards)
export GRAFANA_HOST="${GRAFANA_HOST:-grafana.${K8S_OBSERVABILITY_NS}.${K8S_DNS_SUFFIX}}"

# Loki (log aggregation)
export LOKI_HOST="${LOKI_HOST:-loki.${K8S_OBSERVABILITY_NS}.${K8S_DNS_SUFFIX}}"

# AlertManager (alert routing)
export ALERTMANAGER_HOST="${ALERTMANAGER_HOST:-alertmanager.${K8S_OBSERVABILITY_NS}.${K8S_DNS_SUFFIX}}"

# ============================================================================
# DNS FAILOVER & RESILIENCE CONFIGURATION
# ============================================================================

# Primary & secondary DNS resolvers for cluster DNS
export CLUSTER_DNS_PRIMARY="${CLUSTER_DNS_PRIMARY:-10.0.0.10}"    # CoreDNS service IP
export CLUSTER_DNS_SECONDARY="${CLUSTER_DNS_SECONDARY:-8.8.8.8}"  # Fallback to Google DNS

# DNS query timeout (milliseconds)
export DNS_QUERY_TIMEOUT="${DNS_QUERY_TIMEOUT:-5000}"

# DNS cache TTL (seconds)
export DNS_CACHE_TTL="${DNS_CACHE_TTL:-300}"

# Enable DNS failover (try secondary if primary fails)
export DNS_FAILOVER_ENABLED="${DNS_FAILOVER_ENABLED:-true}"

# ============================================================================
# MIGRATION PHASES
# ============================================================================
# Control which services use Kubernetes DNS vs on-prem DNS

# Phase 3 (Current): Prepare DNS infrastructure, configure CoreDNS
export PHASE_3_DNS_PREP="${PHASE_3_DNS_PREP:-true}"

# Phase 4 (Future): Migrate stateless services to K8s
export PHASE_4_STATELESS_MIGRATION="${PHASE_4_STATELESS_MIGRATION:-false}"

# Phase 5 (Future): Migrate stateful services to K8s with persistent volumes
export PHASE_5_STATEFUL_MIGRATION="${PHASE_5_STATEFUL_MIGRATION:-false}"

# ============================================================================
# VALIDATION & TESTING
# ============================================================================

# Enable DNS resolution validation in scripts
export VALIDATE_DNS_RESOLUTION="${VALIDATE_DNS_RESOLUTION:-true}"

# Test DNS endpoints before using them
export TEST_DNS_ENDPOINTS="${TEST_DNS_ENDPOINTS:-true}"

# Timeout for DNS validation (seconds)
export DNS_VALIDATION_TIMEOUT="${DNS_VALIDATION_TIMEOUT:-30}"
