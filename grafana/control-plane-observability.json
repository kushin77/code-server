{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["production", "sre", "observability", "control-plane"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "label": "Datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "title": "Control Plane Observability",
  "uid": "control-plane-observability",
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Up",
      "id": 1,
      "datasource": "${datasource}",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "expr": "up{job=\"control-plane\"}", "refId": "A", "legendFormat": "up" }
      ]
    },
    {
      "type": "stat",
      "title": "Error Rate (5m)",
      "id": 2,
      "datasource": "${datasource}",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "rate(control_plane_requests_total{status=~\"5..\"}[5m]) / clamp_min(rate(control_plane_requests_total[5m]), 1e-9)",
          "refId": "A",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Request Rate (rps)",
      "id": 3,
      "datasource": "${datasource}",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(rate(control_plane_requests_total[5m]))", "refId": "A", "legendFormat": "rps" }
      ]
    },
    {
      "type": "stat",
      "title": "Latency P95 (5m)",
      "id": 4,
      "datasource": "${datasource}",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.25 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(control_plane_request_latency_seconds_bucket[5m])))", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by Status",
      "id": 5,
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "expr": "sum by (status) (rate(control_plane_requests_total[5m]))", "refId": "A", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency P50/P95/P99",
      "id": 6,
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(control_plane_request_latency_seconds_bucket[5m])))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(control_plane_request_latency_seconds_bucket[5m])))", "refId": "B", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(control_plane_request_latency_seconds_bucket[5m])))", "refId": "C", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Errors by Type",
      "id": 7,
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "targets": [
        { "expr": "sum by (error_type) (rate(control_plane_errors_total[5m]))", "refId": "A", "legendFormat": "{{error_type}}" }
      ]
    }
  ]
}