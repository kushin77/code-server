{
  "name": "code-server-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.15.4 <10"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "install:workspace": "pnpm install",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:bats": "bash scripts/ci/run-shell-library-bats.sh",
    "test:bats:coverage": "bash scripts/ci/run-shell-library-bats.sh --coverage",
    "lint": "pnpm -r --if-present lint",
    "type-check": "pnpm -r --if-present type-check",
    "ci:lockfile": "pnpm install --frozen-lockfile --ignore-scripts",
    "validate:lockfile": "bash scripts/ci/check-pnpm-lockfile.sh",
    "validate:monorepo": "bash scripts/ci/validate-monorepo-target.sh",
    "validate:docs": "python3 scripts/ci/validate-docs-governance.py",
    "test:boundaries": "bash scripts/ci/validate-monorepo-target.sh",
    "validate:issues": "python3 scripts/ops/issue_execution_manifest.py validate",
    "issues:queue": "python3 scripts/ops/issue_execution_manifest.py queue",
    "test:e2e:appsmith-login": "bash scripts/ci/run-kushnir-cloud-appsmith-login-e2e.sh",
    "test:load": "k6 run tests/load/load-test.js",
    "test:load:stress": "k6 run tests/load/stress-test.js",
    "test:load:spike": "k6 run tests/load/spike-test.js",
    "redeploy:portal-oauth": "bash scripts/deploy/redeploy-portal-oauth-routing.sh",
    "redeploy:portal-oauth:dry-run": "bash scripts/deploy/redeploy-portal-oauth-routing.sh --dry-run",
    "hooks:install": "bash scripts/hooks/install-local-git-hooks.sh",
    "validate:hooks": "bash scripts/ci/check-local-git-hook-integrity.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "pnpm": {
    "overrides": {
      "express@<4.19.2": "^4.19.2",
      "body-parser@<1.20.3": "^1.20.3",
      "http-parser@<2.9.4": "^2.9.4",
      "raw-body@<1.4.2": "^1.4.2",
      "accepts@<1.3.8": "^1.3.8",
      "mime-types@<2.1.35": "^2.1.35",
      "content-type@<1.0.4": "^1.0.4",
      "bcryptjs@<2.4.4": "^2.4.4",
      "crypto-js@<4.1.2": "^4.1.2",
      "md5@<2.3.0": "^2.3.0",
      "sha.js@<2.4.12": "^2.4.12",
      "form-data@<2.5.4": "2.5.5",
      "tough-cookie@<4.1.3": "4.1.3",
      "qs@<6.14.1": "6.14.2",
      "uuid": "14.0.0",
      "node-fetch@<2.6.11": "2.6.11",
      "minimist@<1.2.6": "1.2.8",
      "lodash@<4.17.21": "4.17.21",
      "json5@<2.2.2": "2.2.3",
      "ini@<1.3.8": "1.3.8",
      "tar@<6.1.13": "6.1.13",
      "glob@<7.2.3": "7.2.3",
      "braces@<3.0.3": "3.0.3",
      "cross-spawn@<7.0.6": "7.0.6",
      "micromatch@<4.0.8": "4.0.8",
      "cookie@<0.7.0": "0.7.0",
      "ws@<7.5.10": "7.5.10",
      "path-to-regexp@<0.1.12": "0.1.12",
      "send@<0.19.1": "0.19.1",
      "on-finished@<2.4.1": "2.4.1",
      "esbuild@<0.25.0": "0.25.0",
      "js-yaml@<3.14.2": "3.14.2",
      "debug@<3.2.7": "3.2.7",
      "diff@<3.5.1": "3.5.1",
      "@tootallnate/once@<3.0.1": "3.0.1",
      "vite@<6.4.2": "6.4.2"
    }
  }
}
