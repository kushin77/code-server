# ============================================================================
# .env.base - CANONICAL SINGLE SOURCE OF TRUTH (SSOT)
# All application and infrastructure configuration variables
# 
# LOAD ORDER (priority, highest to lowest):
#   1. .env.base (this file - defaults for all environments)
#   2. .env.infrastructure (infrastructure URLs and endpoints)
#   3. .env.deployment (deployment-specific settings)
#   4. .env.cluster (cluster networking and HA settings)
#   5. .env.production (production overrides and secrets)
#
# USAGE: Scripts should source variables in this order:
#   source .env.base
#   [ -f .env.infrastructure ] && source .env.infrastructure
#   [ -f .env.deployment ] && source .env.deployment
#   [ -f .env.cluster ] && source .env.cluster
#   [ -f .env.production ] && source .env.production
#
# Date: April 30, 2026
# ============================================================================

# ============================================================================
# SECTION 1: CORE DOMAIN & IDENTITY CONFIGURATION
# ============================================================================
# Primary domain for all services
# [SSOT] Redundant: APEX_DOMAIN=${APEX_DOMAIN:-kushnir.cloud}

# Domain aliases for specific services
# [SSOT] Redundant: AUTH_DOMAIN=${AUTH_DOMAIN:-auth.kushnir.cloud}
# [SSOT] Redundant: APPSMITH_DOMAIN=${APPSMITH_DOMAIN:-kushnir.cloud}
# [SSOT] Redundant: CODE_SERVER_DOMAIN=${CODE_SERVER_DOMAIN:-kushnir.cloud}
IDE_DOMAIN=${IDE_DOMAIN:-ide.kushnir.cloud}
API_DOMAIN=${API_DOMAIN:-api.kushnir.cloud}
REGISTRY_DOMAIN=${REGISTRY_DOMAIN:-registry.kushnir.cloud}

# TLS/Certificate configuration
# [SSOT] Redundant: TLS_EMAIL=${TLS_EMAIL:-admin@kushnir.cloud}
# [SSOT] Redundant: ADMIN_EMAIL=${ADMIN_EMAIL:-admin@kushnir.cloud}

# ============================================================================
# SECTION 2: API & PROTOCOL CONFIGURATION
# ============================================================================
# [SSOT] Redundant: API_PROTOCOL=${API_PROTOCOL:-http}
# [SSOT] Redundant: API_HOST=${API_HOST:-192.168.168.31}
# [SSOT] Redundant: API_PORT=${API_PORT:-8080}
API_ENDPOINT=${API_ENDPOINT:-http://${API_HOST}:${API_PORT}}
API_HEALTH_ENDPOINT=${API_HEALTH_ENDPOINT:-http://${API_HOST}:${API_PORT}/health}
API_OAUTH_CALLBACK=${API_OAUTH_CALLBACK:-http://${API_HOST}:${API_PORT}/oauth/callback}

# ============================================================================
# SECTION 3: CLUSTER & HIGH AVAILABILITY CONFIGURATION
# ============================================================================
# [SSOT] Redundant: CLUSTER_VIP=${CLUSTER_VIP:-192.168.168.250}
# [SSOT] Redundant: CLUSTER_HOST_1=${CLUSTER_HOST_1:-192.168.168.31}
# [SSOT] Redundant: CLUSTER_HOST_2=${CLUSTER_HOST_2:-192.168.168.42}
# [SSOT] Redundant: PRIMARY_HOST=${PRIMARY_HOST:-192.168.168.31}
# [SSOT] Redundant: REPLICA_HOST=${REPLICA_HOST:-192.168.168.42}

# Deployment mode: primary, replica, or private
# [SSOT] Redundant: DEPLOYMENT_MODE=${DEPLOYMENT_MODE:-private}
# [SSOT] Redundant: REPLICA_ENABLED=${REPLICA_ENABLED:-true}
# [SSOT] Redundant: REPLICATION_MODE=${REPLICATION_MODE:-primary}

