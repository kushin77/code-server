{
  "dashboard": {
    "title": "OPA Policy Monitoring",
    "uid": "opa-policies",
    "tags": ["opa", "policy", "governance"],
    "timezone": "UTC",
    "panels": [
      {
        "title": "Policy Allow/Deny Rate",
        "targets": [
          {
            "expr": "rate(opa_decisions_total[5m])"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Decision Evaluation Latency",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, opa_decision_evaluation_seconds)"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Policy Violations by Type",
        "targets": [
          {
            "expr": "opa_policy_violations_total"
          }
        ],
        "type": "table"
      },
      {
        "title": "OPA Service Health",
        "targets": [
          {
            "expr": "up{job='opa'}"
          }
        ],
        "type": "gauge"
      },
      {
        "title": "Bundle Load Duration",
        "targets": [
          {
            "expr": "opa_bundle_load_duration_ns"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Compiler Compile Duration",
        "targets": [
          {
            "expr": "opa_compiler_compile_duration_ns"
          }
        ],
        "type": "graph"
      }
    ]
  }
}
