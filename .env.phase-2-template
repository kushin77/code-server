# Phase 2: Service-to-Service JWT Authentication Configuration
# This template documents the environment variables required for Phase 2 deployment.
# All values MUST come from GSM or vault - NEVER commit secrets to git.
# See scripts/fetch-gsm-secrets.sh for GSM integration.

# ============= OIDC Issuer Configuration =============
OIDC_ISSUER_URL=http://oauth2-oidc-issuer:4182
OIDC_ISSUER_SIGNING_KEY=REDACTED_SET_VIA_GSM_OR_VAULT

# ============= Service Account Credentials =============
SERVICE_CLIENT_SESSION_BROKER_ID=session-broker
SERVICE_CLIENT_SESSION_BROKER_SECRET=32_CHAR_RANDOM_SECRET_FROM_GSM
SERVICE_CLIENT_BACKEND_ID=backend
SERVICE_CLIENT_BACKEND_SECRET=32_CHAR_RANDOM_SECRET_FROM_GSM

# ============= Session / Infra Secrets =============
IDE_SESSION_LB_SECRET=64_HEX_CHAR_SECRET_FROM_GSM