{
  "dashboard": {
    "id": null,
    "uid": "pg-performance-2026",
    "title": "PostgreSQL Performance Dashboard",
    "tags": ["database", "postgresql", "performance", "#1069"],
    "timezone": "utc",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Active Connections",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "pg_stat_activity_count",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "max": 100,
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 70},
                {"color": "red", "value": 85}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Queries Per Second",
        "type": "timeseries",
        "gridPos": {"x": 6, "y": 0, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "rate(pg_statement_calls[5m])",
            "refId": "A",
            "legendFormat": "{{database}}"
          }
        ]
      },
      {
        "id": 3,
        "title": "Replication Lag",
        "type": "timeseries",
        "gridPos": {"x": 14, "y": 0, "w": 10, "h": 8},
        "targets": [
          {
            "expr": "pg_replication_lag_seconds",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Cache Hit Ratio",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 8, "w": 6, "h": 8},
        "targets": [
          {
            "expr": "pg_cache_hit_ratio_percent",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "max": 100,
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 90},
                {"color": "green", "value": 99}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Query Latency",
        "type": "timeseries",
        "gridPos": {"x": 6, "y": 8, "w": 8, "h": 8},
        "targets": [
          {
            "expr": "avg(pg_statement_mean_time_ms)",
            "refId": "A",
            "legendFormat": "mean"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms"
          }
        }
      },
      {
        "id": 6,
        "title": "Table Bloat (Top 5)",
        "type": "bargauge",
        "gridPos": {"x": 14, "y": 8, "w": 10, "h": 8},
        "targets": [
          {
            "expr": "topk(5, pg_table_total_size_bytes)",
            "refId": "A",
            "legendFormat": "{{schemaname}}.{{tablename}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "id": 7,
        "title": "Transaction Wraparound Age",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "pg_transaction_wraparound_age",
            "refId": "A",
            "legendFormat": "{{database}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 500000000},
                {"color": "red", "value": 1500000000}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Checkpoint Write Time",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "pg_checkpoint_write_time_seconds",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      }
    ]
  }
}
