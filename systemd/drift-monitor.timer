[Unit]
Description=code-server drift monitoring timer (every 5 minutes)
Requires=drift-monitor.service

[Timer]
# Run every 5 minutes
OnBootSec=1min
OnUnitActiveSec=5min

# Run immediately on system startup
AccuracySec=10s

# Persist timer state across reboots
Persistent=true

[Install]
WantedBy=timers.target
