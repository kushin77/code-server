# ============================================================================
# .env.example - TEMPLATE FOR CONFIGURATION
#
# Copy this file to .env and fill in your values. This file is documentation
# of all available configuration variables. Production secrets should be
# provided separately via CI/CD secrets management.
#
# LOAD ORDER (highest to lowest priority):
#   1. Environment variables (set externally)
#   2. .env.base (canonical defaults)
#   3. .env.infrastructure (infrastructure URLs)
#   4. .env.deployment (deployment-specific)
#   5. .env.cluster (cluster settings)
#   6. .env.production (production overrides)
#
# ============================================================================

# CORE DOMAIN & IDENTITY
# Main domain for all services
APEX_DOMAIN=kushnir.cloud

# Domain aliases
AUTH_DOMAIN=auth.kushnir.cloud
APPSMITH_DOMAIN=kushnir.cloud
CODE_SERVER_DOMAIN=kushnir.cloud
IDE_DOMAIN=ide.kushnir.cloud
API_DOMAIN=api.kushnir.cloud
REGISTRY_DOMAIN=registry.kushnir.cloud

# Email configuration for TLS certificates and admin
TLS_EMAIL=admin@kushnir.cloud
ADMIN_EMAIL=admin@kushnir.cloud

# API & PROTOCOL CONFIGURATION
API_PROTOCOL=http
API_HOST=192.168.168.31
API_PORT=8080

# CLUSTER & HIGH AVAILABILITY
CLUSTER_VIP=192.168.168.250
CLUSTER_HOST_1=192.168.168.31
CLUSTER_HOST_2=192.168.168.42
PRIMARY_HOST=192.168.168.31
REPLICA_HOST=192.168.168.42

# Deployment mode: private, primary, or replica
DEPLOYMENT_MODE=private
REPLICA_ENABLED=true
REPLICATION_MODE=primary

# DATABASE CONFIGURATION
DATABASE_HOST=code-server-postgres
DATABASE_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_NAME=code_server

# Connection pooling for better performance
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# REDIS CONFIGURATION
REDIS_HOST=code-server-redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here
REDIS_MAX_MEMORY=512mb
REDIS_EVICTION_POLICY=allkeys-lru
REDIS_APPENDONLY=yes

# MESSAGE BROKER (REDPANDA/KAFKA)
KAFKA_BROKER=code-server-redpanda:9092
KAFKA_TOPIC_PREFIX=code-server.
REDPANDA_PORT=9092
REDPANDA_REST_PORT=8082
REDPANDA_SCHEMA_PORT=8081

# OBSERVABILITY & MONITORING
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_SCRAPE_INTERVAL=15s

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password-here

LOKI_PORT=3100
LOKI_RETENTION_DAYS=30

ALERTMANAGER_PORT=9093
ALERTMANAGER_SMTP_FROM=alerts@kushnir.cloud

# OPENTELEMETRY & TRACING
OTEL_EXPORTER_OTLP_GRPC_PORT=4317
OTEL_EXPORTER_OTLP_HTTP_PORT=4318
OTEL_COLLECTOR_HOST=code-server-otel-collector

TEMPO_GRPC_PORT=4317
TEMPO_HTTP_PORT=3200

# AI/ML & VECTOR DATABASE
OLLAMA_URL=http://code-server-ollama:11434
OLLAMA_MODEL=mistral
OLLAMA_VISION_MODEL=llava

QDRANT_HOST=code-server-qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=your-qdrant-api-key-here

# LLM Backends
DIAGRAM_LLM_BACKEND=openai
VISION_BACKEND=ollama
OPENAI_API_KEY=sk-your-openai-key-here

# POLICY ENGINE (OPA)
OPA_URL=http://code-server-opa:8181
OPA_ADMIN_TOKEN=your-opa-admin-token

# APPLICATION SERVICE PORTS
CONTROL_PLANE_PORT=8000
SCHEDULER_PORT=8001
SCHEDULER_URL=http://code-server-execution-scheduler:8001
SCHEDULER_API_KEY=your-scheduler-api-key

REPUTATION_ENGINE_PORT=8002
REPUTATION_ENGINE_URL=http://code-server-reputation-engine:8002

MEMORY_ENGINE_PORT=8003
MEMORY_SERVICE_API_KEY=your-memory-service-key

MODEL_SERVER_PORT=8004

MULTIMODAL_AI_PORT=8005

RAG_ENGINE_PORT=8006

PAPERCLIP_PORT=8007
PAPERCLIP_URL=http://code-server-paperclip:8007

# AUTONOMOUS AGENTS
AGENT_CODE_REVIEWER_PORT=9001
AGENT_INCIDENT_RESPONDER_PORT=9002
AGENT_DOC_WRITER_PORT=9003
AGENT_TEST_GENERATOR_PORT=9004
AGENT_RUNTIME_PORT=9005
AGENT_RUNTIME_MODEL=gpt-4-turbo

# AUTHENTICATION & OAUTH
OAUTH_ENABLED=true
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

OAUTH2_CLIENT_ID=your-oauth2-client-id
OAUTH2_CLIENT_SECRET=your-oauth2-client-secret
OAUTH2_COOKIE_SECRET=your-oauth2-cookie-secret
OAUTH2_REDIRECT_URL=http://kushnir.cloud/oauth2/callback

CODE_SERVER_PASSWORD=your-code-server-password

# APPSMITH
APPSMITH_INSTANCE_NAME=kushnir-cloud-ide
APPSMITH_ENCRYPTION_PASSWORD=your-appsmith-encryption-password
APPSMITH_ENCRYPTION_SALT=your-appsmith-encryption-salt
APPSMITH_INTERNAL_REDIS_URL=redis://redis-appsmith:6379
APPSMITH_MONGODB_URI=mongodb://mongo-appsmith:27017/appsmith

# LOGGING
LOG_LEVEL=info
LOG_FORMAT=json
AUDIT_LOGGING_ENABLED=true

# API GATEWAY (CADDY)
CADDY_EMAIL=admin@kushnir.cloud
CADDY_AUTO_HTTPS=on

# EXTERNAL INTEGRATIONS
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_BOT_TOKEN=your-slack-bot-token
SENTRY_DSN=https://your-key@sentry.io/project-id
ALERTMANAGER_SLACK_URL=https://hooks.slack.com/services/your/slack/webhook

# STORAGE
NAS_HOST=192.168.168.56
NAS_MOUNT_PATH=/mnt/nas

# DEPLOYMENT & FEATURE FLAGS
DEPLOYMENT_AUTO_ROLLBACK=true
DEPLOYMENT_ENV=production
ENABLE_METRICS=true

# HEALTH CHECKS
HEALTH_CHECK_TIMEOUT=300
HEALTH_CHECK_MAX_ATTEMPTS=30
HEALTH_CHECK_INTERVAL=10
