  "infrastructure_provisioning": {
    "terraform": {
      "modules": [
        "aws_eks_cluster",
        "aws_rds_aurora_multi_region",
        "aws_elasticache_redis",
        "aws_s3_regional_buckets",
        "aws_cloudfront_distribution",
        "aws_route53_health_checks",
        "aws_autoscaling_groups"
      ],
      "backend": "s3",
      "state_locking": "dynamodb",
      "validation": "terraform validate && terraform plan"
    },
    "kubernetes": {
      "distribution": "AWS EKS",
      "service_mesh": "Istio 1.18.0 (STRICT mTLS)",
      "helm_charts": [
        "code-server-enterprise",
        "prometheus-stack",
        "jaeger-operator",
        "fluent-bit",
        "sealed-secrets"
      ],
      "namespaces": ["production", "monitoring", "istio-system"]
    },
    "database": {
      "primary": "Aurora PostgreSQL 15 (Multi-AZ, Multi-Region)",
      "sharding_strategy": "Hash(user_id) % num_shards",
      "replicas": 3,
      "backup_retention_days": 30,
      "pitr_enabled": true
    }
  },
  
  "networking_configuration": {
    "cdn": {
      "provider": "Cloudflare",
      "cache_ttl_seconds": 86400,
      "geo_routing": "Enabled",
      "ddos_protection": "Advanced"
    },
    "load_balancing": {
      "primary": "Cloudflare",
      "backup": "AWS Route53",
      "health_check_interval_seconds": 5,
      "failover_timeout_seconds": 30
    },
    "dns": {
      "primary_domain": "code-server.ai",
      "regional_subdomains": [
        "us-east.code-server.ai",
        "us-west.code-server.ai",
