#!/bin/bash
# @file scripts/_common/_p3-services-config.env
# @description P3 Services Configuration (IaC - Environment SSOT)
# @governance GOV-002: Single Source of Truth, version-controlled, immutable
# @author GitHub Copilot
# @date 2026-04-25
# @related P3 Epics #1558, #1559, #1561

################################################################################
# P3 SERVICES CONFIGURATION - SINGLE SOURCE OF TRUTH
#
# This file defines all configuration for P3 services:
# - Reputation Engine (#1559)
# - Execution Scheduler (#1561)  
# - Paperclip Control Plane (#1558)
# - OPA Policy Engine
#
# All services use this configuration for consistency.
# Update this file, then re-run deployment scripts.
#
# IMMUTABILITY: No hardcoding in scripts/Dockerfiles
# IDEMPOTENCY: Safe to source multiple times
# DETERMINISM: Same config → Same deployments
################################################################################

################################################################################
# SERVICE PORTS (Map to docker-compose.yml)
################################################################################

# Reputation Engine Service
export REPUTATION_ENGINE_PORT="${REPUTATION_ENGINE_PORT:-8002}"
export REPUTATION_ENGINE_HEALTH_PATH="/health"
export REPUTATION_ENGINE_ADMIN_PORT="${REPUTATION_ENGINE_ADMIN_PORT:-8902}"

# Execution Scheduler Service
export EXECUTION_SCHEDULER_PORT="${EXECUTION_SCHEDULER_PORT:-8080}"
export EXECUTION_SCHEDULER_HEALTH_PATH="/health"
export EXECUTION_SCHEDULER_ADMIN_PORT="${EXECUTION_SCHEDULER_ADMIN_PORT:-8880}"

# Paperclip Control Plane Service
export PAPERCLIP_CONTROL_PLANE_PORT="${PAPERCLIP_CONTROL_PLANE_PORT:-8010}"
export PAPERCLIP_CONTROL_PLANE_HEALTH_PATH="/health"
export PAPERCLIP_CONTROL_PLANE_ADMIN_PORT="${PAPERCLIP_CONTROL_PLANE_ADMIN_PORT:-8910}"

# OPA Policy Engine Service
export OPA_PORT="${OPA_PORT:-8181}"
export OPA_HEALTH_PATH="/health"

################################################################################
# SERVICE ENDPOINTS (Fully Qualified URLs)
################################################################################

# Primary endpoints (used by clients)
export REPUTATION_ENGINE_URL="${REPUTATION_ENGINE_URL:-http://reputation-engine:${REPUTATION_ENGINE_PORT}}"
export EXECUTION_SCHEDULER_URL="${EXECUTION_SCHEDULER_URL:-http://execution-scheduler:${EXECUTION_SCHEDULER_PORT}}"
export PAPERCLIP_CONTROL_PLANE_URL="${PAPERCLIP_CONTROL_PLANE_URL:-http://paperclip:${PAPERCLIP_CONTROL_PLANE_PORT}}"
export OPA_URL="${OPA_URL:-http://opa:${OPA_PORT}}"

# Admin endpoints (internal only)
export REPUTATION_ENGINE_ADMIN_URL="${REPUTATION_ENGINE_ADMIN_URL:-http://reputation-engine:${REPUTATION_ENGINE_ADMIN_PORT}}"
export EXECUTION_SCHEDULER_ADMIN_URL="${EXECUTION_SCHEDULER_ADMIN_URL:-http://execution-scheduler:${EXECUTION_SCHEDULER_ADMIN_PORT}}"
export PAPERCLIP_CONTROL_PLANE_ADMIN_URL="${PAPERCLIP_CONTROL_PLANE_ADMIN_URL:-http://paperclip:${PAPERCLIP_CONTROL_PLANE_ADMIN_PORT}}"

################################################################################
# DATABASE CONFIGURATION
################################################################################

# PostgreSQL (Single Source of Truth for all services)
export DB_HOST="${DB_HOST:-postgres}"
export DB_PORT="${DB_PORT:-5432}"
export DB_USER="${DB_USER:-postgres}"
export DB_PASSWORD="${DB_PASSWORD:-postgres}"
export DB_NAME="${DB_NAME:-kushnir}"
export DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Database pool sizes (per service)
export DB_POOL_MIN_SIZE="${DB_POOL_MIN_SIZE:-2}"
export DB_POOL_MAX_SIZE="${DB_POOL_MAX_SIZE:-10}"
export DB_POOL_TIMEOUT="${DB_POOL_TIMEOUT:-30}"

################################################################################
# REDIS CONFIGURATION
################################################################################

# Redis Cache (Session store & temporary data)
export REDIS_HOST="${REDIS_HOST:-redis}"
export REDIS_PORT="${REDIS_PORT:-6379}"
export REDIS_DB="${REDIS_DB:-0}"
export REDIS_URL="redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"

# Redis Sentinel (HA failover) - Optional
export REDIS_SENTINEL_ENABLED="${REDIS_SENTINEL_ENABLED:-false}"
export REDIS_SENTINEL_HOST="${REDIS_SENTINEL_HOST:-redis-sentinel}"
export REDIS_SENTINEL_PORT="${REDIS_SENTINEL_PORT:-26379}"
export REDIS_SENTINEL_MASTER="${REDIS_SENTINEL_MASTER:-mymaster}"

# Redis memory configuration
export REDIS_MAX_MEMORY="${REDIS_MAX_MEMORY:-2gb}"
export REDIS_EVICTION_POLICY="${REDIS_EVICTION_POLICY:-allkeys-lru}"

################################################################################
# KAFKA/EVENT STREAMING CONFIGURATION
################################################################################

# Kafka/Redpanda (Event Stream - Service-to-Service Communication)
export KAFKA_HOST="${KAFKA_HOST:-redpanda}"
export KAFKA_PORT="${KAFKA_PORT:-9092}"
export KAFKA_BROKERS="${KAFKA_BROKERS:-redpanda:9092}"
export KAFKA_TOPICS="${KAFKA_TOPICS:-reputation-events,execution-events,approval-events}"

# Event topic configuration
export REPUTATION_EVENTS_TOPIC="${REPUTATION_EVENTS_TOPIC:-reputation-events}"
export EXECUTION_EVENTS_TOPIC="${EXECUTION_EVENTS_TOPIC:-execution-events}"
export APPROVAL_EVENTS_TOPIC="${APPROVAL_EVENTS_TOPIC:-approval-events}"

# Consumer group prefix (each service has unique group)
export KAFKA_CONSUMER_GROUP_PREFIX="${KAFKA_CONSUMER_GROUP_PREFIX:-kushnir-p3}"

################################################################################
# AUTHENTICATION & AUTHORIZATION
################################################################################

# OPA Policy Engine (Centralized access control)
export OPA_ENABLED="${OPA_ENABLED:-true}"
export OPA_POLICY_DIR="${OPA_POLICY_DIR:-policies}"
export OPA_DEFAULT_POLICY="${OPA_DEFAULT_POLICY:-kushnir/approval_required}"

# Service-to-Service Authentication (Mutual TLS - Optional)
export MTLS_ENABLED="${MTLS_ENABLED:-false}"
export MTLS_CERT_DIR="${MTLS_CERT_DIR:-/etc/tls/certs}"

# API Keys & Tokens
export API_KEY_REPUTATION="${API_KEY_REPUTATION:-}"       # Empty = disabled
export API_KEY_EXECUTION="${API_KEY_EXECUTION:-}"         # Empty = disabled
export API_KEY_PAPERCLIP="${API_KEY_PAPERCLIP:-}"         # Empty = disabled

################################################################################
# LOGGING & OBSERVABILITY
################################################################################

# Log Level (DEBUG, INFO, WARN, ERROR)
export LOG_LEVEL="${LOG_LEVEL:-INFO}"

# Structured Logging (JSON format for log aggregation)
export STRUCTURED_LOGGING_ENABLED="${STRUCTURED_LOGGING_ENABLED:-true}"

# Log Output Destinations
export LOG_OUTPUT="${LOG_OUTPUT:-stdout,file}"
export LOG_FILE_DIR="${LOG_FILE_DIR:-logs}"

# Metrics Collection (Prometheus)
export METRICS_ENABLED="${METRICS_ENABLED:-true}"
export METRICS_PORT="${METRICS_PORT:-9090}"

# Distributed Tracing (Jaeger/Tempo)
export TRACING_ENABLED="${TRACING_ENABLED:-true}"
export JAEGER_AGENT_HOST="${JAEGER_AGENT_HOST:-jaeger}"
export JAEGER_AGENT_PORT="${JAEGER_AGENT_PORT:-6831}"

# Audit Logging (for compliance & incident investigation)
export AUDIT_LOGGING_ENABLED="${AUDIT_LOGGING_ENABLED:-true}"
export AUDIT_LOG_DIR="${AUDIT_LOG_DIR:-logs/audit}"

################################################################################
# RESOURCE CONSTRAINTS (Per-Service)
################################################################################

# Reputation Engine Resource Limits
export REPUTATION_ENGINE_MEMORY="${REPUTATION_ENGINE_MEMORY:-512M}"
export REPUTATION_ENGINE_CPU="${REPUTATION_ENGINE_CPU:-0.5}"
export REPUTATION_ENGINE_TIMEOUT="${REPUTATION_ENGINE_TIMEOUT:-30}"

# Execution Scheduler Resource Limits
export EXECUTION_SCHEDULER_MEMORY="${EXECUTION_SCHEDULER_MEMORY:-1G}"
export EXECUTION_SCHEDULER_CPU="${EXECUTION_SCHEDULER_CPU:-1}"
export EXECUTION_SCHEDULER_TIMEOUT="${EXECUTION_SCHEDULER_TIMEOUT:-60}"

# Paperclip Control Plane Resource Limits
export PAPERCLIP_CONTROL_PLANE_MEMORY="${PAPERCLIP_CONTROL_PLANE_MEMORY:-512M}"
export PAPERCLIP_CONTROL_PLANE_CPU="${PAPERCLIP_CONTROL_PLANE_CPU:-0.5}"
export PAPERCLIP_CONTROL_PLANE_TIMEOUT="${PAPERCLIP_CONTROL_PLANE_TIMEOUT:-30}"

################################################################################
# AVAILABILITY & FAILOVER
################################################################################

# Health Check Intervals & Thresholds
export HEALTH_CHECK_INTERVAL="${HEALTH_CHECK_INTERVAL:-30}"
export HEALTH_CHECK_TIMEOUT="${HEALTH_CHECK_TIMEOUT:-5}"
export HEALTH_CHECK_RETRIES="${HEALTH_CHECK_RETRIES:-3}"

# Liveness & Readiness Probes
export LIVENESS_PROBE_ENABLED="${LIVENESS_PROBE_ENABLED:-true}"
export READINESS_PROBE_ENABLED="${READINESS_PROBE_ENABLED:-true}"

# Service Dependencies (Startup order)
export SERVICE_STARTUP_ORDER="postgres,redis,redpanda,opa,reputation-engine,paperclip,execution-scheduler"

# Restart Policy
export RESTART_POLICY="${RESTART_POLICY:-always}"
export RESTART_MAX_ATTEMPTS="${RESTART_MAX_ATTEMPTS:-5}"
export RESTART_DELAY="${RESTART_DELAY:-10}"

################################################################################
# COMPLIANCE & GOVERNANCE
################################################################################

# Environment Identification
export ENVIRONMENT="${ENVIRONMENT:-development}"
export REGION="${REGION:-local}"
export CLUSTER_NAME="${CLUSTER_NAME:-primary}"

# Deployment Version & Tracking
export DEPLOYMENT_VERSION="${DEPLOYMENT_VERSION:-1.0.0}"
export DEPLOYMENT_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')

# Compliance Settings
export ENABLE_AUDIT_LOGGING="${ENABLE_AUDIT_LOGGING:-true}"
export ENABLE_ENCRYPTION="${ENABLE_ENCRYPTION:-false}"    # TLS for services
export DATA_RETENTION_DAYS="${DATA_RETENTION_DAYS:-90}"

################################################################################
# TESTING & DEVELOPMENT
################################################################################

# Integration Test Configuration
export INTEGRATION_TEST_TIMEOUT="${INTEGRATION_TEST_TIMEOUT:-60}"
export INTEGRATION_TEST_RETRIES="${INTEGRATION_TEST_RETRIES:-3}"
export INTEGRATION_TEST_MODE="${INTEGRATION_TEST_MODE:-false}"

# Mock Services (for local development)
export USE_MOCK_OPA="${USE_MOCK_OPA:-false}"
export USE_MOCK_EMAIL="${USE_MOCK_EMAIL:-true}"

# Debug Mode (verbose logging)
export DEBUG="${DEBUG:-false}"
export VERBOSE="${VERBOSE:-false}"

################################################################################
# DERIVED CONFIGURATION (Auto-calculated, read-only)
################################################################################

# Full service URLs with scheme
export REPUTATION_ENGINE_FULL_URL="${REPUTATION_ENGINE_URL}${REPUTATION_ENGINE_HEALTH_PATH}"
export EXECUTION_SCHEDULER_FULL_URL="${EXECUTION_SCHEDULER_URL}${EXECUTION_SCHEDULER_HEALTH_PATH}"
export PAPERCLIP_CONTROL_PLANE_FULL_URL="${PAPERCLIP_CONTROL_PLANE_URL}${PAPERCLIP_CONTROL_PLANE_HEALTH_PATH}"

# Service Registry (for service discovery)
export SERVICE_REGISTRY=(
  "reputation-engine|${REPUTATION_ENGINE_URL}"
  "execution-scheduler|${EXECUTION_SCHEDULER_URL}"
  "paperclip|${PAPERCLIP_CONTROL_PLANE_URL}"
  "opa|${OPA_URL}"
)

################################################################################
# DOCUMENTATION
################################################################################

# Usage:
#   source scripts/_common/_p3-services-config.env
#   echo "Reputation Engine URL: $REPUTATION_ENGINE_URL"
#   docker-compose up -d  # Uses all exported variables
#
# Override defaults:
#   export LOG_LEVEL=DEBUG
#   export REPUTATION_ENGINE_PORT=9002
#   source scripts/_common/_p3-services-config.env
#
# List all P3 configuration:
#   grep '^export' scripts/_common/_p3-services-config.env | grep -v '#'

################################################################################
# GOV-002 COMPLIANCE
#
# ✅ Single Source of Truth (SSOT):
#    - All P3 configuration in ONE file
#    - No duplication across scripts
#    - Version-controlled in Git
#
# ✅ Environment-Driven (Immutable):
#    - All values via environment variables
#    - Defaults provided (can be overridden)
#    - No hardcoding in scripts or Dockerfiles
#
# ✅ Idempotency:
#    - Safe to source multiple times
#    - No state mutations
#    - Derived config calculated, not stored
#
# ✅ Determinism:
#    - Same environment → Same configuration
#    - Reproducible deployments
#    - Auditable changes (via Git history)
#
################################################################################
