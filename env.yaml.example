version: "1.0"
metadata:
  name: kc-ide-standard
  env: local

compute:
  replicas: 1
  profiles: ["ai", "tracing", "monitoring"]

data:
  postgres:
    version: "15"
    ha: false
  redis:
    version: "7"
    mode: standalone

ai:
  providers:
    - name: ollama
      enabled: true
      models: ["llama3:8b", "codellama:13b", "mistral:7b"]
    - name: openai
      enabled: false

networking:
  domain: localhost
  tls: none
