{
  "version": "1.0",
  "title": "ElevatedIQ DevOS Environment Variables Schema",
  "description": "Single Source of Truth (SSOT) for all environment variable definitions across the platform. This schema defines all configurable parameters for deployment, infrastructure, and application runtime.",
  "last_updated": "2026-04-25",
  "categories": {
    "infrastructure": "Infrastructure and deployment configuration",
    "identity": "Identity and authentication configuration",
    "observability": "Monitoring, logging, and tracing configuration",
    "database": "Database and persistence configuration",
    "cache": "Caching and session storage configuration",
    "messaging": "Message broker and event streaming configuration",
    "services": "Internal service configuration",
    "security": "Security policies and credentials"
  },
  "variables": {
    "APEX_DOMAIN": {
      "category": "infrastructure",
      "type": "string",
      "required": true,
      "default": "kushnir.cloud",
      "description": "Root domain for all services and endpoints",
      "examples": ["kushnir.cloud", "company.com", "elevatediq.ai"],
      "usage": ["Caddyfile", "docker-compose.yml", "Terraform", "scripts"]
    },
    "IDE_DOMAIN": {
      "category": "infrastructure",
      "type": "string",
      "required": false,
      "description": "Fully-qualified domain for the code-server IDE endpoint. Defaults to ide.<APEX_DOMAIN>.",
      "examples": ["ide.kushnir.cloud", "code.company.com"],
      "usage": ["Caddyfile", "oauth2-proxy", "E2E tests"]
    },
    "REGISTRY_URL": {
      "category": "infrastructure",
      "type": "string",
      "required": false,
      "description": "Container registry base URL for custom images. Leave empty to use Docker Hub defaults.",
      "examples": ["registry.kushnir.cloud", "ghcr.io/kushin77"],
      "usage": ["docker-compose*.yml", "Dockerfile", "CI build workflows"]
    },
    "PRIMARY_HOST": {
      "category": "infrastructure",
      "type": "string",
      "required": true,
      "description": "Primary deployment host (IP address or hostname)",
      "pattern": "^[A-Za-z0-9.-]+$",
      "location": "scripts/_common/_base-config.env",
      "usage": ["SSH deployment", "Health checks", "Failover"]
    },
    "REPLICA_HOST": {
      "category": "infrastructure",
      "type": "string",
      "required": true,
      "description": "Replica/secondary deployment host for failover (IP address or hostname)",
      "pattern": "^[A-Za-z0-9.-]+$",
      "location": "scripts/_common/_base-config.env",
      "usage": ["SSH failover", "Replication", "Testing"]
    },
    "NAS_HOST": {
      "category": "infrastructure",
      "type": "string",
      "required": true,
      "description": "Network-attached storage (NAS) host for persistent data (IP address or hostname)",
      "pattern": "^[A-Za-z0-9.-]+$",
      "location": "scripts/_common/_base-config.env",
      "usage": ["NAS mount", "Backup", "Persistent storage"]
    },
    "DEPLOYMENT_ENV": {
      "category": "infrastructure",
      "type": "string",
      "required": false,
      "default": "local",
      "enum": ["local", "staging", "production"],
      "description": "Deployment environment identifier",
      "usage": ["Logging", "Telemetry", "Feature flags"]
    },
    "TLS_EMAIL": {
      "category": "security",
      "type": "string",
      "required": false,
      "description": "Email for Let's Encrypt certificate registration",
      "pattern": "^[^@]+@[^@]+$",
      "usage": ["Caddy ACME", "Certificate renewal"]
    },
    "LOG_LEVEL": {
      "category": "observability",
      "type": "string",
      "required": false,
      "default": "INFO",
      "enum": ["DEBUG", "INFO", "WARN", "ERROR"],
      "description": "Global log level for services",
      "usage": ["All services", "Docker Compose", "Applications"]
    },
    "GRAFANA_ADMIN_USER": {
      "category": "identity",
      "type": "string",
      "required": false,
      "default": "admin",
      "description": "Grafana admin username",
      "sensitive": true,
      "usage": ["Grafana initialization"]
    },
    "GRAFANA_ADMIN_PASSWORD": {
      "category": "identity",
      "type": "string",
      "required": false,
      "sensitive": true,
      "description": "Grafana admin password (should be in secrets manager)",
      "usage": ["Grafana initialization"]
    },
    "DB_USER": {
      "category": "database",
      "type": "string",
      "required": false,
      "default": "postgres",
      "description": "PostgreSQL database user",
      "sensitive": true,
      "usage": ["DATABASE_URL", "Docker Compose"]
    },
    "DB_PASSWORD": {
      "category": "database",
      "type": "string",
      "required": false,
      "sensitive": true,
      "description": "PostgreSQL database password",
      "usage": ["DATABASE_URL", "Docker Compose"]
    },
    "DB_NAME": {
      "category": "database",
      "type": "string",
      "required": false,
      "default": "elevatediq",
      "description": "PostgreSQL database name",
      "usage": ["DATABASE_URL"]
    },
    "DATABASE_URL": {
      "category": "database",
      "type": "string",
      "required": false,
      "pattern": "^postgresql://[^:]+:[^@]+@[^:]+:\\d+/[^\\s]+$",
      "description": "PostgreSQL connection string (templated from DB_* vars)",
      "computed": "postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}",
      "usage": ["Backend services", "ORM initialization"]
    },
    "REDIS_PASSWORD": {
      "category": "cache",
      "type": "string",
      "required": false,
      "sensitive": true,
      "description": "Redis authentication password",
      "usage": ["Redis initialization", "Session store"]
    },
    "KAFKA_BROKER": {
      "category": "messaging",
      "type": "string",
      "required": false,
      "default": "redpanda:9092",
      "description": "Kafka/Redpanda broker address",
      "usage": ["Services configuration"]
    },
    "OPA_URL": {
      "category": "services",
      "type": "string",
      "required": false,
      "default": "http://opa:8181",
      "description": "Open Policy Agent (OPA) service endpoint",
      "usage": ["Authorization", "Policy engine"]
    },
    "QDRANT_API_KEY": {
      "category": "security",
      "type": "string",
      "required": false,
      "sensitive": true,
      "description": "Qdrant vector database API key",
      "usage": ["Vector store authentication"]
    },
    "OLLAMA_HOST": {
      "category": "services",
      "type": "string",
      "required": false,
      "default": "http://localhost:11434",
      "description": "Ollama LLM runtime endpoint (external deployment). Set to external host:port after deploying https://github.com/kushin77/ollama independently",
      "examples": ["http://localhost:11434", "http://ollama-primary.kushnir.cloud:11434", "http://ollama.internal:11434"],
      "location": ".env or docker-compose.yml environment",
      "notes": [
        "As of April 2026, Ollama is no longer deployed in main docker-compose.yml",
        "Deploy Ollama separately: git clone https://github.com/kushin77/ollama && docker compose --profile ai up -d",
        "Services (memory-engine, multimodal-ai) reference this env var with fallback to http://localhost:11434",
        "For development and production, use an external Ollama deployment"
      ],
      "usage": ["AI services", "Model inference", "Memory engine", "Multimodal services"],
      "related_issues": ["#1546 - AI/Ollama Separation"]
    },
    "OLLAMA_MODEL": {
      "category": "services",
      "type": "string",
      "required": false,
      "default": "llama3:8b",
      "description": "Default Ollama model to load",
      "usage": ["Model selection", "Runtime configuration"]
    },
    "OLLAMA_VISION_MODEL": {
      "category": "services",
      "type": "string",
      "required": false,
      "default": "llava:13b",
      "description": "Ollama vision/multimodal model to load",
      "usage": ["Multimodal services", "Image analysis"]
    },
    "VISION_BACKEND": {
      "category": "services",
      "type": "string",
      "required": false,
      "default": "ollama",
      "enum": ["ollama", "openai", "none"],
      "description": "Vision/image analysis backend provider",
      "usage": ["Multimodal services"]
    },
    "OPENAI_API_KEY": {
      "category": "security",
      "type": "string",
      "required": false,
      "sensitive": true,
      "description": "OpenAI API key for fallback models",
      "usage": ["Optional OpenAI integration"]
    },
    "WHISPER_MODEL": {
      "category": "services",
      "type": "string",
      "required": false,
      "default": "base",
      "enum": ["tiny", "small", "base", "medium", "large"],
      "description": "OpenAI Whisper speech-to-text model size",
      "usage": ["Audio transcription"]
    },
    "TTS_BACKEND": {
      "category": "services",
      "type": "string",
      "required": false,
      "default": "gtts",
      "enum": ["gtts", "elevenlabs", "openai"],
      "description": "Text-to-speech backend provider",
      "usage": ["Audio generation"]
    },
    "DIAGRAM_LLM_BACKEND": {
      "category": "services",
      "type": "string",
      "required": false,
      "default": "ollama",
      "enum": ["ollama", "openai"],
      "description": "LLM backend for diagram generation",
      "usage": ["Visualization services"]
    },
    "REPUTATION_ENGINE_URL": {
      "category": "services",
      "type": "string",
      "required": false,
      "default": "http://reputation-engine:8000",
      "description": "Reputation/scoring engine endpoint",
      "usage": ["Trust scoring", "Authority checks"]
    },
    "OTLP_ENDPOINT": {
      "category": "observability",
      "type": "string",
      "required": false,
      "default": "http://otel-collector:4317",
      "description": "OpenTelemetry Collector gRPC endpoint",
      "usage": ["Distributed tracing", "Telemetry export"]
    },
    "TEMPO_ENDPOINT": {
      "category": "observability",
      "type": "string",
      "required": false,
      "default": "http://tempo:4317",
      "description": "Grafana Tempo tracing backend endpoint",
      "usage": ["Trace storage", "Query interface"]
    },
    "PROMETHEUS_SCRAPE_INTERVAL": {
      "category": "observability",
      "type": "string",
      "required": false,
      "default": "15s",
      "description": "Prometheus scrape interval for metrics collection",
      "usage": ["Prometheus configuration"]
    },
    "LOKI_ENDPOINT": {
      "category": "observability",
      "type": "string",
      "required": false,
      "default": "http://loki:3100",
      "description": "Grafana Loki logs aggregation endpoint",
      "usage": ["Log ingestion", "Log queries"]
    }
  },
  "environment_files": {
    ".env.local": {
      "purpose": "Local development overrides",
      "override": true,
      "gitignore": true
    },
    ".env.staging": {
      "purpose": "Staging environment configuration",
      "override": true,
      "gitignore": true
    },
    ".env.prod": {
      "purpose": "Production environment configuration",
      "override": true,
      "gitignore": true
    }
  },
  "validation_rules": {
    "no_hardcoded_ips": "All IP addresses must use PRIMARY_HOST, REPLICA_HOST, or NAS_HOST variables",
    "no_duplicate_definitions": "Each variable defined in exactly one place (this schema)",
    "sensitive_variables_in_secrets": "All sensitive variables (passwords, keys) stored in external secrets manager",
    "environment_specific_overrides": "Environment-specific values in .env.{env} files, not in code"
  },
  "ci_enforcement": {
    "check_env_references": "All env var references must be defined in this schema",
    "check_no_hardcoded_values": "No hardcoded credentials or sensitive data in code",
    "check_variable_consistency": "Variable names match schema definitions"
  }
}
