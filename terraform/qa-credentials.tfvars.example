# @file        terraform/qa-credentials.tfvars.example
# @module      gcp/iam/credentials
# @description Example Terraform variables for QA credential management
#
# IMPORTANT: This is a TEMPLATE. Do not use in production.
# For production: Use GitHub Actions secrets to pass variables
#

# GCP Project ID where credentials will be stored
gcp_project_id = "kushin77-ops"

# QA User Email (immutable)
qa_email = "qa@kushnir.cloud"

# QA User Password (SENSITIVE - never commit, use CI secrets)
# For local testing: terraform apply -var="qa_password=<PASSWORD>"
# For CI/CD: Use GitHub Actions secrets (automatically injected)
qa_password = "*** REPLACE WITH ACTUAL PASSWORD ***"

# CI Service Account Email (GitHub Actions WIF)
ci_service_account_email = "github-actions@kushin77-ops.iam.gserviceaccount.com"
