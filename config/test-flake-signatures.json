{
  "version": 1,
  "policy": {
    "rerunLimit": 1,
    "rerunOn": ["flake"]
  },
  "signatures": [
    {
      "name": "deterministic_assertion_failure",
      "decision": "non_flake",
      "priority": 100,
      "description": "Hard assertion mismatch or expectation failure that should not be rerun",
      "patterns": [
        "AssertionError",
        "expect\\(.*\\)\\.(toBe|toEqual|toContain|toMatch|toHaveText|toHaveURL)",
        "Expected:",
        "Received:"
      ]
    },
    {
      "name": "browser_disconnect",
      "decision": "flake",
      "priority": 90,
      "description": "Browser, page, or context disconnected unexpectedly",
      "patterns": [
        "Target closed",
        "browser has been closed",
        "Browser disconnected",
        "page crashed",
        "Execution context was destroyed",
        "Protocol error.*Target closed"
      ]
    },
    {
      "name": "transient_network",
      "decision": "flake",
      "priority": 80,
      "description": "Transient network or socket failure",
      "patterns": [
        "ECONNRESET",
        "ETIMEDOUT",
        "socket hang up",
        "net::ERR_CONNECTION_RESET",
        "net::ERR_TIMED_OUT",
        "getaddrinfo ENOTFOUND"
      ]
    },
    {
      "name": "timeout_exceeded",
      "decision": "flake",
      "priority": 70,
      "description": "Timeout without a clear assertion mismatch",
      "patterns": [
        "TimeoutError",
        "timed out after",
        "Timeout .*ms exceeded",
        "waiting for .* failed: timeout",
        "Test timeout of .*ms exceeded"
      ]
    },
    {
      "name": "environment_unavailable",
      "decision": "flake",
      "priority": 60,
      "description": "Infrastructure or DNS resolution issue that is typically transient",
      "patterns": [
        "ERR_NAME_NOT_RESOLVED",
        "503 Service Unavailable",
        "502 Bad Gateway",
        "connection refused",
        "ECONNREFUSED"
      ]
    }
  ]
}