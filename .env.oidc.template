# OIDC Issuer Configuration for Phase 2.1
# ⚠️  TEMPLATE ONLY - Secrets loaded from Google Secret Manager
# Never commit actual private keys to git

# OIDC_ISSUER_SIGNING_KEY is loaded from GSM at runtime
# Command: gcloud secrets versions access latest --secret=oidc-issuer-signing-key
# The key is injected as an environment variable before startup

OIDC_ISSUER_SIGNING_KEY=${OIDC_ISSUER_SIGNING_KEY:?Error: OIDC_ISSUER_SIGNING_KEY not loaded from GSM}
OIDC_ISSUER_VERIFICATION_KEY=${OIDC_ISSUER_VERIFICATION_KEY:?Error: OIDC_ISSUER_VERIFICATION_KEY not loaded from GSM}
OIDC_ISSUER_URL=https://ide.kushnir.cloud
OIDC_CLIENT_ID=${OIDC_CLIENT_ID:?Error: OIDC_CLIENT_ID required}
OIDC_CLIENT_SECRET=${OIDC_CLIENT_SECRET:?Error: OIDC_CLIENT_SECRET not loaded from GSM}
