# @file .env.local (git-ignored - copy to .env for local development)
# Docker Compose environment variables for local development

# Infrastructure
APEX_DOMAIN=kushnir.local
TLS_EMAIL=admin@kushnir.local
LOG_LEVEL=debug

# Database
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=dev_password_local

# Redis Cache
REDIS_PASSWORD=dev_redis_local

# OAuth2 Proxy (GitHub example)
OAUTH2_CLIENT_ID=your_github_oauth_app_id
OAUTH2_CLIENT_SECRET=your_github_oauth_app_secret
OAUTH2_COOKIE_SECRET=$(openssl rand -hex 16)

# Grafana Admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev_grafana_local

# OPA
OPA_ADDR=0.0.0.0:8181

# Qdrant Vector DB
QDRANT_API_KEY=dev_qdrant_key_local

# AI/ML
OLLAMA_HOST=http://ollama:11434
