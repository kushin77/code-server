# Addition to docker-compose.yml for Presence Sidecar Service
# Include this in the main docker-compose.yml services section

presence-sidecar:
  build:
    context: .
    dockerfile: apps/presence-sidecar/Dockerfile
  container_name: presence-sidecar
  restart: unless-stopped
  environment:
    NODE_ENV: production
    PORT: 8089
    MATRIX_HOMESERVER_URL: ${MATRIX_HOMESERVER_URL:-https://matrix.kushnir.cloud}
    MATRIX_BOT_ACCESS_TOKEN: ${MATRIX_BOT_ACCESS_TOKEN}
    MATRIX_PRESENCE_ROOM_ID: ${MATRIX_PRESENCE_ROOM_ID}
    REDIS_URL: ${REDIS_URL:-redis://redis:6379}
    PRESENCE_AWAY_TIMEOUT_MS: ${PRESENCE_AWAY_TIMEOUT_MS:-300000}
    PRESENCE_OFFLINE_TIMEOUT_MS: ${PRESENCE_OFFLINE_TIMEOUT_MS:-900000}
    LOG_LEVEL: ${LOG_LEVEL:-info}
  ports:
    - "8089:8089"
  networks:
    - net-app
  healthcheck:
    test: ["CMD", "curl", "-f", "http://localhost:8089/health"]
    interval: 30s
    timeout: 10s
    retries: 3
    start_period: 10s
  depends_on:
    redis:
      condition: service_healthy
  volumes:
    - /etc/localtime:/etc/localtime:ro
  logging:
    driver: json-file
    options:
      max-size: "10m"
      max-file: "3"
