# @file Caddyfile
# @module config/caddy
# @description Caddy reverse proxy configuration with TLS hardening (P1 Priority 2)
# @governance GOV-002 - All requests validated by OPA, TLS enforced

# Global options - SSL/TLS Hardening (P1 Priority 2)
{
	# Listen on secure ports only
	http_port 80
	https_port 443
	
	# Automatic HTTPS and certificate renewal
	auto_https on
	storage file_system /data
	
	# Admin interface - localhost only (no remote access)
	admin localhost:2019
	
	# JSON logging with audit trail
	log {
		format json
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 10
		}
	}
	
	# TLS Policy Enforcement (P1 Priority 2)
	# =========================================
	# Minimum TLS version: 1.2
	# Reason: TLS 1.3 not universally supported, 1.2 is secure minimum
	
	# Strong cipher suites (no weak ciphers)
	servers :443 {
		protocols h2 http/1.1
		
		# TLS configuration for maximum security
		tls_policies {
			# Enforce TLS 1.2 minimum (no TLS 1.0/1.1)
			min_version tls1_2
			
			# Disable weak/obsolete ciphers
			ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
			ciphers TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
			ciphers TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
			ciphers TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
			ciphers TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
			ciphers TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
			
			# Prefer server ciphers
			prefer_server_cipher_suites
		}
	}
}

# Development environment (kushnir.local)
kushnir.local, *.kushnir.local, ${APEX_DOMAIN}, *.${APEX_DOMAIN} {
	# HTTP → HTTPS redirect
	# All traffic must use encrypted connection
	redir http:// https:// permanent
	
	log {
		level debug
	}
	
	# TLS Certificate Configuration (P1 Priority 2)
	# Automated certificate generation and renewal
	tls internal {
		# For development/internal use
	}
	
	# Common Security Headers (P1 Priority 2)
	header / {
		# HSTS: Force HTTPS for 1 year (31536000 seconds)
		# Prevents SSL stripping attacks
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		
		# Content Security Policy: Restrict resource loading
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https:; frame-ancestors 'none';"
		
		# Prevent MIME type sniffing
		X-Content-Type-Options "nosniff"
		
		# Prevent clickjacking
		X-Frame-Options "DENY"
		
		# XSS Protection header
		X-XSS-Protection "1; mode=block"
		
		# Referrer Policy: Don't leak referrer to external sites
		Referrer-Policy "strict-origin-when-cross-origin"
		
		# Feature Policy (Permissions Policy)
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		
		# Remove Server header (don't leak Caddy version)
		-Server
	}

	# Health check endpoint
	handle /health {
		respond "OK" 200
	}

	# Protected API endpoints - require OPA authorization
	handle /api/* {
		# Additional API-specific security headers
		header /api/* {
			# API response should never be cached
			Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
			Pragma "no-cache"
			Expires "0"
		}
		
		# Step 1: Verify OPA policy allows request
		forward_auth http://opa:8181 {
			uri /v1/data/identity/sso_required?input={
				"action":"access_service",
				"service_type":"user_facing",
				"auth_token":{auth_header},
				"source_ip":{remote_ip}
			}
			copy_headers Authorization X-User-ID X-SSL-Version X-SSL-Cipher
			# If OPA denies, respond with 403
			handle_errors 401 403 {
				respond "Unauthorized: Policy enforcement denied access" 403
			}
		}

		# Step 2: Route to backend service
		reverse_proxy http://backend:8000 {
			header_up X-Forwarded-For {http.request.remote}
			header_up X-Forwarded-Proto {http.request.proto}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-User-ID {http.request.header.User-ID}
			# Pass SSL version and cipher to backend for logging
			header_up X-SSL-Version {http.request.tls.version}
			header_up X-SSL-Cipher {http.request.tls.cipher}
		}
	}

	# Admin endpoints - stricter policy checks
	handle /admin/* {
		# No caching for admin pages
		header /admin/* {
			Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
			Pragma "no-cache"
		}
		
		# Require device trust and reputation checks
		forward_auth http://opa:8181 {
			uri /v1/data/identity/reputation_gate?input={
				"action":"execute_operation",
				"operation_type":"modify_admin_config",
				"actor_id":{user_id},
				"actor_reputation_score":{reputation_score},
				"device_id":{device_id},
				"device_trust_score":{device_trust}
			}
			handle_errors 401 403 {
				respond "Insufficient permissions: Admin access denied" 403
			}
		}

		reverse_proxy http://admin-service:9000 {
			header_up X-User-ID {http.request.header.User-ID}
			header_up X-Audit-ID {uuid}
			header_up X-SSL-Cipher {http.request.tls.cipher}
		}
	}

	# AI Model endpoints - model allowlist and budget checks
	handle /models/* {
		# AI endpoint security headers
		header /models/* {
			Cache-Control "public, max-age=300"  # Cache model metadata briefly
		}
		
		forward_auth http://opa:8181 {
			uri /v1/data/ai/model_allowlist?input={
				"action":"invoke_model",
				"model_name":{model_param},
				"actor_id":{user_id},
				"actor_reputation_score":{reputation_score},
				"current_concurrent_count":{concurrent_count}
			}
			handle_errors 401 403 {
				respond "Model access denied: Insufficient reputation or budget" 403
			}
		}

		reverse_proxy http://model-gateway:8080 {
			header_up X-Model-Name {model_param}
			header_up X-User-ID {user_id}
			header_up X-SSL-Version {http.request.tls.version}
		}
	}

	# Root domain routes to Appsmith Portal (OAuth protected entry point)
	# kushnir.cloud → Appsmith Hermes Agent Dashboard
	handle /, /paperclip, /paperclip/* {
		# Security headers for dashboard
		header / {
			# OAuth2 protection enabled
			X-OAuth-Protected "true"
			X-Portal-Type "hermes-agent"
			# Prevent frame embedding (unless from same origin)
			X-Frame-Options "SAMEORIGIN"
		}
		
		# Appsmith dashboard with OAuth2 Google integration
		reverse_proxy http://appsmith:80 {
			header_up X-Forwarded-For {http.request.remote}
			header_up X-Forwarded-Proto {http.request.proto}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Prefix {http.request.uri.path_prefix}
			header_up Host appsmith
			# Pass OAuth context
			header_up X-OAuth-Token {http.request.header.Authorization}
			header_up X-User-Email {http.request.header.X-User-Email}
			# API backend integration
			header_up X-API-Gateway "hermes-integration:8000"
		}
	}

	# Code-Server IDE access (separate from Appsmith dashboard)
	# kushnir.cloud/ide → code-server IDE with Hermes Agent integration
	handle /ide* {
		# IDE-specific security headers
		header /ide* {
			X-Portal-Type "code-server-ide"
			# Allow frame embedding for IDE functionality
			X-Frame-Options "SAMEORIGIN"
		}
		reverse_proxy http://code-server-ide:8080 {
			header_up X-Forwarded-For {http.request.remote}
			header_up X-Forwarded-Proto {http.request.proto}
			header_up X-Forwarded-Host {http.request.host}
			# Pass OAuth for IDE authentication
			header_up X-OAuth-Token {http.request.header.Authorization}
			header_up X-User-Email {http.request.header.X-User-Email}
		}
	}

	# GitLab access
	# kushnir.cloud/gitlab → GitLab instance
	handle /gitlab* {
		header /gitlab* {
			X-Portal-Type "gitlab"
		}
		reverse_proxy http://gitlab:80 {
			header_up X-Forwarded-For {http.request.remote}
			header_up X-Forwarded-Proto {http.request.proto}
			header_up X-Forwarded-Host {http.request.host}
		}
	}

	# Hermes Agent API access (REST API)
	# kushnir.cloud/api/hermes/* → hermes-integration service
	handle /api/hermes/* {
		# API-specific security headers
		header /api/hermes/* {
			Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
			X-API-Service "hermes-integration"
		}
		
		# OAuth validation for API calls
		# Strip /api/hermes prefix when forwarding to service
		reverse_proxy http://hermes-integration:8000 {
			header_up X-Forwarded-For {http.request.remote}
			header_up X-Forwarded-Proto {http.request.proto}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-OAuth-Token {http.request.header.Authorization}
			header_up X-User-Email {http.request.header.X-User-Email}
			header_up Authorization {http.request.header.Authorization}
		}
	}

	# Catch-all: deny unknown paths
	handle {
		respond "Not Found" 404
	}

	# Error handling
	handle_errors {
		respond "Internal error" 500
	}
}

