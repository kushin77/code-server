# Single-stage Dockerfile for session-broker to fix pnpm isolation issues
FROM node:22-slim@sha256:db9a3a15e8e8e2adbaf1e1c3d93dfb04c2e294bdd027490addb2391b8e61cc6a

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends curl jq && rm -rf /var/lib/apt/lists/*

# Setup user/group
RUN groupadd -g 999 docker 2>/dev/null || true && \
    useradd -m -u 1000 -g 999 session-broker 2>/dev/null || true && \
    usermod -aG docker session-broker 2>/dev/null || true

# Copy workspace context
COPY pnpm-workspace.yaml pnpm-lock.yaml .npmrc package.json ./
COPY apps/session-broker ./apps/session-broker
COPY apps/backend ./apps/backend

# Install ALL dependencies and build using pnpm hoisted
RUN npm install -g pnpm@9.15.4 && \
    pnpm install --frozen-lockfile --config.node-linker=hoisted && \
    cd apps/session-broker && \
    pnpm run build

# Setup runtime environment
RUN cp -r apps/session-broker/dist ./dist && \
    cp apps/session-broker/package.json ./package.json && \
    rm -rf apps tests packages

RUN chown -R 1000:999 /app
USER 1000
EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD curl -f http://localhost:5000/health || exit 1
CMD ["node", "dist/index.js"]
