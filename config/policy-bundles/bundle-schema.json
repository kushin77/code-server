{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enterprise Policy Bundle",
  "type": "object",
  "required": [
    "bundle_id",
    "version",
    "channel",
    "generated_at",
    "expires_at",
    "policies",
    "signature"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "pattern": "^pb-[0-9]{8}-[0-9]{6}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "channel": {
      "type": "string",
      "enum": ["canary", "stable", "rollback"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^(sha256:[a-f0-9]{64}|RS256:[a-zA-Z0-9_-]+)$"
    },
    "signed_by": {
      "type": "string",
      "description": "Key ID used for signing (for rotation compatibility)"
    },
    "key_version": {
      "type": "integer",
      "description": "Vault key version used (for tracking rotation state)"
    }
  }
}
