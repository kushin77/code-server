{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["production", "sre", "slo", "code-server"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "label": "Datasource"
      },
      {
        "name": "service",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "label": "Service"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "title": "Production - Service Health Overview",
  "uid": "prod-service-health",
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Service Availability (5m)",
      "id": 1,
      "datasource": "${datasource}",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 0.99 },
              { "color": "green",  "value": 0.999 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "avg(up{job=~\"$service\"})",
          "refId": "A",
          "legendFormat": "availability"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error Rate (5xx, 5m)",
      "id": 2,
      "datasource": "${datasource}",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 0.005 },
              { "color": "red",    "value": 0.01 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=~\"$service\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=~\"$service\"}[5m])), 1)",
          "refId": "A",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Request Rate (rps)",
      "id": 3,
      "datasource": "${datasource}",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(rate(http_requests_total{job=~\"$service\"}[5m]))", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Latency P95 (5m)",
      "id": 4,
      "datasource": "${datasource}",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red",    "value": 1.0 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\"$service\"}[5m])))", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency P50/P95/P99",
      "id": 5,
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\"$service\"}[5m])))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\"$service\"}[5m])))", "refId": "B", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=~\"$service\"}[5m])))", "refId": "C", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by status class",
      "id": 6,
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        { "expr": "sum by (status) (rate(http_requests_total{job=~\"$service\"}[5m]))", "refId": "A", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Up by job (1=up, 0=down)",
      "id": 7,
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "targets": [
        { "expr": "up{job=~\"$service\"}", "refId": "A", "legendFormat": "{{job}} / {{instance}}" }
      ]
    }
  ]
}
