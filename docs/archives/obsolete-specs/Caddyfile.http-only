# Minimal Caddyfile for on-prem development behind Cloudflare
# HTTP only - Cloudflare handles HTTPS/TLS termination
# Listens on port 80 only

# Disable ACME certificate fetching
{
    auto_https off
}

# Listen on HTTP only (Cloudflare terminates TLS)
:80 {
    # Health check endpoint
    @health path /health /healthz /ping
    respond @health "OK" 200

    # Proxy all other traffic to oauth2-proxy (using IP to bypass DNS resolution issues)
    reverse_proxy 172.28.1.2:4180 {
        header_up Host ide.kushnir.cloud
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
    }
}
