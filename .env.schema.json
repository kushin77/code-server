{
  "version": "1.0",
  "description": "Authoritative schema for environment variables; see CONFIG-SSOT-MASTER.md for precedence",
  "last_updated": "2026-04-20",
  "author": "Infrastructure Team",
  "purpose": "Define all environment variables with validation, type hints, and secret marking for Vault integration",
  
  "groups": {
    "infrastructure": {
      "description": "Core infrastructure and deployment configuration",
      "variables": {
        "DEPLOYMENT_ENV": {
          "type": "string",
          "enum": ["dev", "staging", "production", "onprem"],
          "required": true,
          "default": "dev",
          "example": "production",
          "description": "Deployment environment (controls behavior, logging, security levels)"
        },
        "APEX_DOMAIN": {
          "type": "string",
          "required": true,
          "format": "domain",
          "example": "kushnir.cloud",
          "description": "Root domain for all services (used by Caddyfile, DNS, certificates)",
          "production": "kushnir.cloud",
          "staging": "staging.kushnir.cloud",
          "dev": "localhost"
        },
        "PRIMARY_HOST_IP": {
          "type": "string",
          "format": "ipv4",
          "required": true,
          "example": "192.168.168.31",
          "description": "Primary production host IP (where Docker runs)",
          "production": "192.168.168.31",
          "staging": "192.168.168.32",
          "dev": "127.0.0.1"
        },
        "PRIMARY_HOST": {
          "type": "string",
          "format": "ipv4",
          "required": true,
          "example": "192.168.168.31",
          "description": "Canonical primary host alias used by Caddy failover and orchestration",
          "production": "192.168.168.31",
          "staging": "192.168.168.32",
          "dev": "127.0.0.1"
        },
        "DEPLOY_HOST": {
          "type": "string",
          "format": "ipv4",
          "required": true,
          "example": "192.168.168.31",
          "description": "Legacy alias for PRIMARY_HOST_IP used by deployment scripts and on-prem task definitions",
          "production": "192.168.168.31",
          "staging": "192.168.168.32",
          "dev": "127.0.0.1"
        },
        "STANDBY_HOST_IP": {
          "type": "string",
          "format": "ipv4",
          "required": false,
          "example": "192.168.168.30",
          "description": "Failover/replica host IP",
          "production": "192.168.168.30",
          "staging": "192.168.168.33"
        },
        "SSH_PORT": {
          "type": "integer",
          "required": false,
          "default": 22,
          "min": 1024,
          "max": 65535,
          "description": "SSH port for deployment host"
        },
        "DOCKER_SOCKET": {
          "type": "string",
          "required": true,
          "default": "unix:///var/run/docker.sock",
          "example": "ssh://akushnir@192.168.168.31",
          "description": "Docker daemon socket (local or remote SSH)"
        },
        "NAS_HOST": {
          "type": "string",
          "format": "ipv4",
          "required": true,
          "default": "192.168.168.56",
          "example": "192.168.168.56",
          "description": "Canonical NAS host for shared volumes, backups, and workspace data"
        },
        "NAS_MOUNT_POINT": {
          "type": "string",
          "required": true,
          "default": "/mnt/nas",
          "example": "/mnt/nas",
          "description": "Local mount point for NAS-backed volumes"
        },
        "NAS_EXPORT_PATH": {
          "type": "string",
          "required": true,
          "default": "/export",
          "example": "/export",
          "description": "Remote export root on the NAS host"
        },
        "IDE_WINDOWS_BACKEND_HOST": {
          "type": "string",
          "required": true,
          "format": "hostname",
          "default": "windows-ide.prod.internal",
          "example": "windows-ide.prod.internal",
          "description": "DNS name for the Windows-backed IDE ingress target behind the NAS ingress"
        },
        "NFS_VERSION": {
          "type": "string",
          "required": true,
          "default": "nfs4",
          "example": "nfs4",
          "description": "NFS protocol version for NAS-backed mounts"
        }
      }
    },

    "authentication": {
      "description": "OAuth2, OIDC, and user authentication",
      "variables": {
        "GOOGLE_CLIENT_ID": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/oauth2/google/client_id",
          "required": true,
          "example": "YOUR-CLIENT-ID.apps.googleusercontent.com",
          "description": "Google OAuth2 Client ID (from Google Cloud Console)",
          "notes": "Store in Vault, not in .env files"
        },
        "GOOGLE_CLIENT_SECRET": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/oauth2/google/client_secret",
          "required": true,
          "description": "Google OAuth2 Client Secret",
          "notes": "Rotate every 90 days"
        },
        "OAUTH2_REDIRECT_URL": {
          "type": "string",
          "format": "url",
          "required": false,
          "example": "https://ide.kushnir.cloud/oauth2/callback",
          "description": "Legacy shared OAuth2 callback URL (prefer surface-specific vars below)"
        },
        "OAUTH2_PROXY_IDE_REDIRECT_URL": {
          "type": "string",
          "format": "url",
          "required": false,
          "example": "https://ide.kushnir.cloud/oauth2/callback",
          "description": "IDE OAuth2 callback URL (must match Google Console for ide.kushnir.cloud)"
        },
        "OAUTH2_PROXY_PORTAL_REDIRECT_URL": {
          "type": "string",
          "format": "url",
          "required": false,
          "example": "https://kushnir.cloud/oauth2/callback",
          "description": "Portal OAuth2 callback URL (must match Google Console for kushnir.cloud)"
        },
        "OAUTH2_PROXY_COOKIE_SECRET": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/oauth2-proxy/cookie_secret",
          "required": true,
          "validation": "length==32",
          "format": "hex",
          "example": "0123456789abcdef0123456789abcdef",
          "description": "Cookie encryption key (32 hex chars = 16 bytes AES)",
          "generation": "openssl rand -hex 16"
        },
        "OAUTH2_PROXY_CSRF_TRUSTED_HOSTS": {
          "type": "string",
          "required": false,
          "example": "ide.kushnir.cloud,.kushnir.cloud",
          "description": "Comma-separated trusted hosts for oauth2-proxy CSRF validation"
        },
        "GITHUB_TOKEN": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/github/token",
          "required": false,
          "description": "GitHub personal access token (for CI/CD)",
          "scopes": ["repo", "workflow", "admin:repo_hook"]
        },
        "E2E_USER_EMAIL": {
          "type": "string",
          "format": "email",
          "secret": false,
          "required": false,
          "source": "gsm:qa-user-email",
          "example": "qa@kushnir.cloud",
          "description": "QA service account email for E2E testing (created via Google Workspace)"
        },
        "E2E_USER_PASSWORD": {
          "type": "string",
          "secret": true,
          "required": false,
          "source": "gsm:qa-user-password",
          "vault_path": "secret/e2e/qa-password",
          "description": "QA service account password for E2E testing (stored in GSM, never in code)",
          "notes": "Rotation policy: quarterly or when user is recreated"
        },
        "E2E_USER_OAUTH_TOKEN": {
          "type": "string",
          "secret": true,
          "required": false,
          "source": "gsm:qa-oauth-token",
          "vault_path": "secret/e2e/qa-oauth-token",
          "description": "Cached OAuth refresh token for E2E testing (optional, for faster test setup)"
        }
      }
    },

    "database": {
      "description": "PostgreSQL and data store configuration",
      "variables": {
        "POSTGRES_HOST": {
          "type": "string",
          "required": true,
          "default": "postgres",
          "example": "postgres.default.svc.cluster.local",
          "description": "PostgreSQL hostname"
        },
        "POSTGRES_PORT": {
          "type": "integer",
          "required": false,
          "default": 5432,
          "description": "PostgreSQL port"
        },
        "POSTGRES_DB": {
          "type": "string",
          "required": true,
          "default": "code_server",
          "description": "Database name"
        },
        "POSTGRES_USER": {
          "type": "string",
          "required": true,
          "default": "postgres",
          "description": "PostgreSQL user"
        },
        "POSTGRES_PASSWORD": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/postgres/password",
          "required": true,
          "description": "PostgreSQL password"
        },
        "REDIS_HOST": {
          "type": "string",
          "required": true,
          "default": "redis",
          "description": "Redis hostname"
        },
        "REDIS_PORT": {
          "type": "integer",
          "required": false,
          "default": 6379,
          "description": "Redis port"
        },
        "REDIS_PASSWORD": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/redis/password",
          "required": true,
          "description": "Redis password"
        }
      }
    },

    "security": {
      "description": "Security and encryption configuration",
      "variables": {
        "TLS_CERT_FILE": {
          "type": "string",
          "required": false,
          "example": "/etc/caddy/certs/ide.kushnir.cloud.crt",
          "description": "TLS certificate file path (auto-generated by Let's Encrypt if not provided)"
        },
        "TLS_KEY_FILE": {
          "type": "string",
          "required": false,
          "example": "/etc/caddy/certs/ide.kushnir.cloud.key",
          "description": "TLS private key file path (auto-generated by Let's Encrypt if not provided)"
        },
        "SOPS_AGE_KEY_FILE": {
          "type": "string",
          "required": false,
          "example": "/home/akushnir/.sops/age/keys.txt",
          "description": "SOPS age key file for secret encryption (development only)"
        },
        "SOPS_ENABLED": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Enable SOPS secret encryption for sensitive files"
        },
        "CLOUDFLARE_API_TOKEN": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/cloudflare/api_token",
          "required": true,
          "description": "Cloudflare API token for DNS and edge automation"
        }
      }
    },

    "observability": {
      "description": "Logging, metrics, and tracing",
      "variables": {
        "LOG_LEVEL": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "required": false,
          "default": "info",
          "description": "Global log level"
        },
        "PROMETHEUS_PORT": {
          "type": "integer",
          "required": false,
          "default": 9090,
          "description": "Prometheus metrics port"
        },
        "GRAFANA_PORT": {
          "type": "integer",
          "required": false,
          "default": 3000,
          "description": "Grafana dashboard port"
        },
        "JAEGER_ENABLED": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Enable distributed tracing (Jaeger)"
        },
        "JAEGER_ENDPOINT": {
          "type": "string",
          "format": "url",
          "required": false,
          "default": "http://localhost:16686",
          "description": "Jaeger UI endpoint"
        },
        "LOKI_HOST": {
          "type": "string",
          "required": false,
          "default": "loki",
          "description": "Loki log aggregation host"
        },
        "LOKI_PORT": {
          "type": "integer",
          "required": false,
          "default": 3100,
          "description": "Loki port"
        }
      }
    },

    "services": {
      "description": "Service-specific configuration",
      "variables": {
        "CODE_SERVER_PORT": {
          "type": "integer",
          "required": false,
          "default": 8080,
          "description": "KC IDE application port (internal, behind OAuth2 proxy)"
        },
        "CODE_SERVER_BIND": {
          "type": "string",
          "required": false,
          "default": "127.0.0.1",
          "description": "KC IDE bind address (localhost for security)"
        },
        "CODE_SERVER_PASSWORD": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/code-server/password",
          "required": true,
          "description": "Primary KC IDE password shared with session-broker spawned containers",
          "notes": "Must be provided from Vault or a local secret file; do not commit plaintext"
        },
        "CODE_SERVER_IMAGE_ID": {
          "type": "string",
          "required": false,
          "default": "code-server-enterprise:dev",
          "description": "Digest-pinned container image used by session-broker for new KC IDE sessions"
        },
        "SESSION_PROVENANCE_ATTESTATION_REF": {
          "type": "string",
          "required": false,
          "default": "rekor://attestations/session-broker@v1",
          "description": "Attestation reference for session provenance verification"
        },
        "SESSION_PROVENANCE_SIGNER_IDENTITY": {
          "type": "string",
          "required": false,
          "default": "github.com/kushin77/code-server/.github/workflows/verified-build.yml",
          "description": "Signer identity for the trusted session provenance manifest"
        },
        "SESSION_PROVENANCE_VERIFIED_AT": {
          "type": "string",
          "required": false,
          "description": "ISO-8601 timestamp for the provenance verification event"
        },
        "SESSION_PROVENANCE_POLICY_VERSION": {
          "type": "string",
          "required": false,
          "default": "v1.0.0",
          "description": "Session provenance policy version"
        },
        "SESSION_PROVENANCE_FRESHNESS_HOURS": {
          "type": "integer",
          "required": false,
          "default": 24,
          "min": 1,
          "description": "Freshness window for session provenance verification"
        },
        "SESSION_PROVENANCE_VERIFICATION_RESULT": {
          "type": "string",
          "enum": ["verified", "rejected"],
          "required": false,
          "default": "verified",
          "description": "Verification result for the trusted provenance manifest"
        },
        "SESSION_USE_REDIS": {
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "Enable Redis-backed session persistence for the session broker"
        },
        "SESSION_REDIS_REQUIRED": {
          "type": "boolean",
          "required": false,
          "default": true,
          "description": "Fail closed when Redis session persistence cannot be initialized"
        },
        "REDIS_SENTINEL_URLS": {
          "type": "string",
          "required": false,
          "default": "redis-sentinel://redis-sentinel-1:26379,redis-sentinel-arbiter:26379/mymaster",
          "description": "Comma-separated Redis Sentinel URLs used by the broker"
        },
        "REDIS_SENTINEL_DB": {
          "type": "integer",
          "required": false,
          "default": 1,
          "min": 0,
          "description": "Redis database number for session persistence"
        },
        "SESSION_REDIS_TTL_SECONDS": {
          "type": "integer",
          "required": false,
          "default": 86400,
          "min": 60,
          "description": "TTL for session records persisted in Redis"
        },
        "SESSION_REDIS_NAMESPACE": {
          "type": "string",
          "required": false,
          "default": "session-broker",
          "description": "Namespace prefix for Redis session keys"
        },
        "DATABASE_URL": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/session-broker/database-url",
          "required": false,
          "description": "Session broker database connection string"
        },
        "SESSION_BROKER_LOG_LEVEL": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "required": false,
          "default": "info",
          "description": "Session broker log level"
        },
        "IDE_SESSION_LB_SECRET": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/caddy/ide-session-lb-secret",
          "required": true,
          "format": "hex",
          "length": 64,
          "description": "HMAC key for Caddy sticky-session cookie (ide_session_lb). 64-character hex string (32 bytes). Used for load-balancer affinity across session-broker instances.",
          "notes": "Must be generated via 'openssl rand -hex 32' and stored in Google Secret Manager (GSM). Same value deployed on both primary (.31) and replica (.42) hosts. Do NOT hardcode or commit to git.",
          "example": "a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b",
          "rotation_policy": "90 days (or immediately if compromised)",
          "vault_creation": "gcloud secrets create ide-session-lb-secret --replication-policy=automatic && openssl rand -hex 32 | gcloud secrets versions add ide-session-lb-secret --data-file=-"
        },
        "OIDC_ISSUER_URL": {
          "type": "string",
          "required": false,
          "default": "http://oauth2-oidc-issuer:4182",
          "description": "Internal URL for the OIDC token issuer (Phase 2.1). Used by services to acquire and validate JWT tokens."
        },
        "SERVICE_CLIENT_SESSION_BROKER_ID": {
          "type": "string",
          "secret": false,
          "required": true,
          "description": "OAuth2 client_id for session-broker service account (Phase 2 service-to-service auth)"
        },
        "SERVICE_CLIENT_SESSION_BROKER_SECRET": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/service-accounts/session-broker/client-secret",
          "required": true,
          "description": "OAuth2 client_secret for session-broker service account. Must be stored in GSM.",
          "rotation_policy": "90 days"
        },
        "SESSION_CPU_LIMIT": {
          "type": "string",
          "required": false,
          "default": "2.0",
          "description": "CPU quota assigned to each session container"
        },
        "SESSION_MEMORY_LIMIT": {
          "type": "string",
          "required": false,
          "default": "4g",
          "description": "Memory quota assigned to each session container"
        },
        "SESSION_STORAGE_LIMIT": {
          "type": "string",
          "required": false,
          "default": "50g",
          "description": "Workspace storage quota assigned to each session container"
        },
        "SESSION_MAX_CONCURRENT_PER_USER": {
          "type": "integer",
          "required": false,
          "default": 1,
          "min": 1,
          "description": "Maximum active sessions a single user may launch"
        },
        "SESSION_MAX_CONCURRENT_PER_TEAM": {
          "type": "integer",
          "required": false,
          "default": 3,
          "min": 1,
          "description": "Maximum active sessions allowed per team/domain"
        },
        "SESSION_MAX_RUNTIME_SECONDS": {
          "type": "integer",
          "required": false,
          "default": 28800,
          "min": 1,
          "description": "Maximum session runtime before automatic teardown"
        },
        "SESSION_MAX_INACTIVITY_SECONDS": {
          "type": "integer",
          "required": false,
          "default": 7200,
          "min": 1,
          "description": "Maximum inactivity window before automatic teardown"
        },
        "SESSION_USAGE_WINDOW_HOURS": {
          "type": "integer",
          "required": false,
          "default": 24,
          "min": 1,
          "description": "Rolling window used by usage telemetry summaries"
        },
        "SESSION_DELETION_QUARANTINE_HOURS": {
          "type": "integer",
          "required": false,
          "default": 24,
          "min": 1,
          "description": "Quarantine window before a terminated session can be hard-purged"
        },
        "TOKEN_TTL_MINUTES": {
          "type": "integer",
          "required": false,
          "default": 15,
          "min": 1,
          "description": "JWT token lifetime for the token microservice"
        },
        "REFRESH_WINDOW_MINUTES": {
          "type": "integer",
          "required": false,
          "default": 5,
          "min": 0,
          "description": "JWT refresh window for the token microservice"
        },
        "OIDC_ISSUER": {
          "type": "string",
          "required": false,
          "default": "https://oidc.kushnir.cloud",
          "description": "OIDC issuer claim used by the token microservice"
        },
        "PLATFORM_NAME": {
          "type": "string",
          "required": false,
          "default": "kushnir-platform",
          "description": "Audience / platform name used in issued tokens"
        },
        "CODE_SERVER_SECRET": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/token-microservice/code-server-secret",
          "required": false,
          "description": "Client secret for the code-server service account"
        },
        "POSTGRESQL_SECRET": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/token-microservice/postgresql-secret",
          "required": false,
          "description": "Client secret for the PostgreSQL service account"
        },
        "REDIS_SECRET": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/token-microservice/redis-secret",
          "required": false,
          "description": "Client secret for the Redis service account"
        },
        "GRAFANA_SECRET": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/token-microservice/grafana-secret",
          "required": false,
          "description": "Client secret for the Grafana service account"
        },
        "PROMETHEUS_SECRET": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/token-microservice/prometheus-secret",
          "required": false,
          "description": "Client secret for the Prometheus service account"
        },
        "OLLAMA_SECRET": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/token-microservice/ollama-secret",
          "required": false,
          "description": "Client secret for the Ollama service account"
        },
        "MINIO_ENDPOINT": {
          "type": "string",
          "format": "domain",
          "required": false,
          "example": "s3.kushnir.cloud",
          "description": "MinIO S3 endpoint"
        },
        "MINIO_ACCESS_KEY": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/minio/access_key",
          "required": false,
          "description": "MinIO access key"
        },
        "MINIO_SECRET_KEY": {
          "type": "string",
          "secret": true,
          "vault_path": "secret/minio/secret_key",
          "required": false,
          "description": "MinIO secret key"
        },
        "OLLAMA_ENABLED": {
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Enable local LLM (Ollama)"
        },
        "OLLAMA_VERSION": {
          "type": "string",
          "required": false,
          "default": "latest",
          "example": "0.1.25",
          "description": "Ollama container version"
        }
      }
    }
  },

  "loading_order": {
    "priority": "highest_last",
    "sequence": [
      {
        "step": 1,
        "file": ".env.defaults",
        "description": "All default values (lowest priority)",
        "tracked": true
      },
      {
        "step": 2,
        "file": ".env.${DEPLOYMENT_ENV}",
        "description": "Environment-specific overrides (prod, staging, dev)",
        "tracked": true,
        "examples": [".env.production", ".env.staging", ".env.dev"]
      },
      {
        "step": 3,
        "file": "${HOME}/.code-server/.env",
        "description": "User-local overrides (not tracked, for local testing)",
        "tracked": false
      },
      {
        "step": 4,
        "file": "Vault secrets",
        "description": "Runtime secrets from Vault (highest priority)",
        "tracked": false,
        "note": "Requires SOPS or Vault client authentication"
      }
    ]
  },

  "validation": {
    "required_variables": [
      "DEPLOYMENT_ENV",
      "APEX_DOMAIN",
      "PRIMARY_HOST_IP",
      "PRIMARY_HOST",
      "CODE_SERVER_PASSWORD",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "OAUTH2_PROXY_COOKIE_SECRET",
      "POSTGRES_PASSWORD",
      "REDIS_PASSWORD",
      "CLOUDFLARE_API_TOKEN",
      "IDE_SESSION_LB_SECRET",
      "DEPLOY_HOST",
      "DOCKER_SOCKET",
      "IDE_WINDOWS_BACKEND_HOST",
