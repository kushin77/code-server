FROM node:20.11.0-alpine

# Set working directory
WORKDIR /app

# Copy integration files
COPY scripts/integrations/slack-slash-commands-service.js ./
COPY scripts/integrations/slack-slash-commands-api.js ./
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci --only=production

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
  CMD node -e "require('http').get('http://localhost:9096/health', (r) => r.statusCode === 200 ? process.exit(0) : process.exit(1))"

# Start API server
CMD ["node", "slack-slash-commands-api.js"]
