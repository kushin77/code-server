export POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-postgres-dev-password}
export POSTGRES_INITDB_ARGS=${POSTGRES_INITDB_ARGS:--c max_wal_senders=10 -c wal_level=replica}

# Database connection URL (constructed)
export DATABASE_URL=${DATABASE_URL:-postgresql://${DB_USER}:${DB_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DB_NAME}}

# Connection pooling
export DATABASE_POOL_SIZE=${DATABASE_POOL_SIZE:-20}
export DATABASE_MAX_OVERFLOW=${DATABASE_MAX_OVERFLOW:-40}

# ============================================================================
# SECTION 5: REDIS CONFIGURATION (SSOT)
