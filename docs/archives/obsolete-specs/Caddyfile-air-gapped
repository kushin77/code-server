# Caddyfile Configuration for Air-Gapped Deployment
# Internal network only, self-signed TLS certificates

{
  admin off
  log {
    level info
  }
}

# ════════════════════════════════════════════════════════════════════════════
# Code-Server IDE
# ════════════════════════════════════════════════════════════════════════════
localhost:8080,
127.0.0.1:8080,
192.168.168.31:8080 {
  reverse_proxy code-server:8080 {
    header_up X-Forwarded-For {http.request.remote.host}
    header_up X-Forwarded-Proto {http.request.proto}
    header_up X-Forwarded-Host {http.request.host}
  }
}

# ════════════════════════════════════════════════════════════════════════════
# Matrix Homeserver - Client API (port 8008)
# ════════════════════════════════════════════════════════════════════════════
matrix.internal:8008,
localhost:8008,
127.0.0.1:8008,
192.168.168.31:8008 {
  tls internal

  reverse_proxy synapse:8008 {
    header_up X-Forwarded-For {http.request.remote.host}
    header_up X-Forwarded-Proto {http.request.proto}
    header_up X-Forwarded-Host {http.request.host}
  }

  # Well-known endpoints (no external federation)
  @well-known {
    path /.well-known/matrix/server
    path /.well-known/matrix/client
  }

  handle @well-known {
    # Return minimal well-known responses (internal only)
    respond `{"m.homeserver": {"base_url": "https://matrix.internal"}}` 200 {
      header Content-Type application/json
    }
  }
}

# ════════════════════════════════════════════════════════════════════════════
# Matrix Client Web (Element)
# ════════════════════════════════════════════════════════════════════════════
matrix.internal,
localhost:443,
127.0.0.1:443,
192.168.168.31:443 {
  tls internal

  reverse_proxy element-web:80 {
    header_up X-Forwarded-For {http.request.remote.host}
    header_up X-Forwarded-Proto {http.request.proto}
    header_up X-Forwarded-Host {http.request.host}
  }

  # Static files caching
  @static {
    path *.js *.css *.woff *.woff2 *.ttf *.svg *.png *.jpg *.ico
  }

  header @static Cache-Control "public, max-age=86400"

  # API requests: no cache
  @api {
    path /_matrix/*
    path /_synapse/*
  }

  header @api Cache-Control "no-cache, no-store, must-revalidate"
}

# ════════════════════════════════════════════════════════════════════════════
# Prometheus Metrics (internal network only)
# ════════════════════════════════════════════════════════════════════════════
prometheus.internal:9090,
192.168.168.31:9090 {
  tls internal

  reverse_proxy prometheus:9090 {
    header_up X-Forwarded-For {http.request.remote.host}
    header_up X-Forwarded-Proto {http.request.proto}
  }

  # Basic auth recommended for metrics
  # basicauth / {
  #   prometheus PASSWORD_HASH
  # }
}

# ════════════════════════════════════════════════════════════════════════════
# Grafana Dashboards (internal network only)
# ════════════════════════════════════════════════════════════════════════════
grafana.internal:3000,
192.168.168.31:3000 {
  tls internal

  reverse_proxy grafana:3000 {
    header_up X-Forwarded-For {http.request.remote.host}
    header_up X-Forwarded-Proto {http.request.proto}
  }
}

# ════════════════════════════════════════════════════════════════════════════
# AlertManager (internal network only)
# ════════════════════════════════════════════════════════════════════════════
alertmanager.internal:9093,
192.168.168.31:9093 {
  tls internal

  reverse_proxy alertmanager:9093 {
    header_up X-Forwarded-For {http.request.remote.host}
    header_up X-Forwarded-Proto {http.request.proto}
  }
}

# ════════════════════════════════════════════════════════════════════════════
# Health Check Endpoint
# ════════════════════════════════════════════════════════════════════════════
localhost/healthz {
  respond "ok" 200
}

192.168.168.31/healthz {
  respond "ok" 200
}

# ════════════════════════════════════════════════════════════════════════════
# IMPORTANT NOTES FOR AIR-GAPPED DEPLOYMENT
# ════════════════════════════════════════════════════════════════════════════
#
# 1. TLS: Using self-signed certificates (tls internal)
#    - Caddy auto-generates and manages certificates
#    - Clients must accept self-signed certs or use system CA bundle
#
# 2. Federation: DISABLED
#    - No port 8448 listener
#    - .well-known responses are minimal (internal only)
#    - Federation from external servers will be rejected by Synapse
#
# 3. Internal DNS Required
#    - Clients must be able to resolve matrix.internal, prometheus.internal, etc
#    - Add to /etc/hosts on air-gapped host:
#      192.168.168.31 matrix.internal prometheus.internal grafana.internal
#
# 4. No External Routes
#    - All listeners bound to localhost, 127.0.0.1, or 192.168.168.31
#    - No routing to external networks
#    - Firewall should block all outbound on net-internal
#
# 5. Monitoring Access
#    - Prometheus and Grafana accessible to authorized internal users only
#    - Consider adding basicauth for production security
#
# 6. Updating Configuration
#    - Modify this file and run: docker-compose -f docker-compose-air-gapped.yml restart caddy
#    - Changes are hot-reloaded
