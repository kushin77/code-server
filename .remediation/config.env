# Auto-Remediation Configuration for code-server Infrastructure
# Controls automated self-healing behavior and safety policies

# ============================================================================
# REMEDIATION POLICIES
# ============================================================================

# Enable/disable individual remediation strategies
REMEDIATE_UNHEALTHY_CONTAINERS=true   # Auto-restart unhealthy containers
REMEDIATE_DISK_SPACE=true              # Auto-cleanup Docker artifacts when disk high
REMEDIATE_TERRAFORM_DRIFT=false        # Auto-apply Terraform on drift (DANGEROUS - disabled by default)

# ============================================================================
# SAFETY SETTINGS
# ============================================================================

# DRY_RUN: Don't make actual changes, just simulate
# false = Make actual changes (production)
# true = Simulate only (testing/validation)
DRY_RUN=false

# SAFE_MODE: Block dangerous operations even if enabled
# true = Always safe (will not apply Terraform)
# false = Allow all configured remediations (use carefully!)
SAFE_MODE=true

# ============================================================================
# CONTAINER REMEDIATION
# ============================================================================

# Maximum auto-restarts per container per hour (prevent infinite restart loops)
MAX_AUTO_RESTARTS_PER_HOUR=5

# Containers to NEVER auto-restart (critical or stateful)
# Comma-separated list
DO_NOT_AUTO_RESTART="postgresql,redis,keepalived"

# Wait time between restart attempts (seconds)
RESTART_WAIT_TIME=30

# ============================================================================
# DISK SPACE REMEDIATION
# ============================================================================

# Trigger disk cleanup when usage exceeds this percentage
DISK_CLEANUP_THRESHOLD=85

# Cleanup strategy (safe order)
# 1. Stopped containers
# 2. Dangling images
# 3. Unused volumes
# 4. Build cache
DISK_CLEANUP_ORDER="containers,images,volumes,cache"

# Skip cleanup for specific volume patterns
# Comma-separated list of regex patterns
SKIP_VOLUME_PATTERNS="postgresql-data,redis-data"

# ============================================================================
# TERRAFORM DRIFT REMEDIATION (EXPERIMENTAL)
# ============================================================================

# Threshold for auto-remediation
# If drift exceeds this many resources, block auto-apply (too risky)
DRIFT_REMEDIATION_THRESHOLD=10

# Timeout for Terraform apply (seconds)
TERRAFORM_APPLY_TIMEOUT=300

# Resources to NEVER auto-remediate
# Comma-separated list of Terraform resource types
DO_NOT_AUTO_REMEDIATE="aws_rds_instance,aws_s3_bucket,docker_container.postgresql"

# ============================================================================
# ALERT INTEGRATION
# ============================================================================

# Send alerts for each remediation action
SEND_REMEDIATION_ALERTS=true

# Alert level for successful remediations
SUCCESS_ALERT_LEVEL=INFO

# Alert level for failed remediations
ERROR_ALERT_LEVEL=ERROR

# ============================================================================
# REMEDIATION SCHEDULE
# ============================================================================

# How often to run auto-remediation (systemd timer interval)
# Format: systemd calendar expression
REMEDIATION_INTERVAL="*:0/5"  # Every 5 minutes

# Quiet hours (don't remediate during these times)
# Format: HH:MM-HH:MM
QUIET_HOURS_START="22:00"
QUIET_HOURS_END="08:00"

# Skip remediation on these days (0=Sunday, 1=Monday, etc.)
# Comma-separated list
SKIP_REMEDIATION_DAYS=""  # Empty = remediate every day

# ============================================================================
# ROLLBACK & RECOVERY
# ============================================================================

# Keep rollback snapshots of Terraform state
KEEP_STATE_SNAPSHOTS=true
STATE_SNAPSHOT_COUNT=10

# Automatic rollback on failed Terraform apply
AUTO_ROLLBACK_ON_FAILURE=true

# ============================================================================
# LOGGING & AUDIT
# ============================================================================

# Log file location
REMEDIATION_LOG="/tmp/code-server-remediation.log"

# Log retention (days)
LOG_RETENTION_DAYS=30

# Audit trail for compliance (keep all remediations)
AUDIT_LOG="/var/log/code-server-remediation-audit.log"

# ============================================================================
# HOSTS & CONNECTIVITY
# ============================================================================

PRIMARY_HOST="192.168.168.31"
REPLICA_HOST="192.168.168.42"
SSH_USER="akushnir"
SSH_KEY="/home/akushnir/.ssh/id_rsa"
SSH_TIMEOUT=10

# ============================================================================
# ADVANCED SETTINGS
# ============================================================================

# Rate limiting: maximum remediations per hour
MAX_REMEDIATIONS_PER_HOUR=20

# Backoff strategy: increase delay between retries
# linear = Add fixed delay each retry
# exponential = Double delay each retry
BACKOFF_STRATEGY="exponential"
BACKOFF_BASE_DELAY=5  # seconds

# Required approvers for dangerous operations (email list)
# Leave empty to disable (use SAFE_MODE instead)
APPROVAL_EMAILS=""

# Webhook for remediation events (optional)
# Will POST remediation results to this URL
WEBHOOK_URL=""

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================

# To enable auto-remediation:
# 1. Review and understand this configuration
# 2. Start with DRY_RUN=true to test first
# 3. Enable SAFE_MODE=true until comfortable
# 4. Gradually enable individual remediations
# 5. Set up systemd timer to run periodically
# 6. Monitor logs and alerts

# WARNING: Auto-remediation can cause unintended changes
# - Always start in DRY_RUN mode
# - Keep SAFE_MODE enabled until tested
# - Never auto-remediate Terraform drift in production
# - Monitor remediation logs daily
# - Have rollback plan ready
