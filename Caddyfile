# Production Caddyfile — kushnir.cloud / ide.kushnir.cloud
# Caddy 2.7.6 — direct TLS termination with existing Let's Encrypt certs
# Certs stored in enterprise_caddy-data volume (valid until 2026-07-19)
# NOTE: Caddy must run as root (user 0) to access root-owned cert files.
# OIDC issuer routes removed until custom issuer service is deployed (#1029).

ide.kushnir.cloud {
    # Issue #1686 FIX: Use internal certificates to bypass Let's Encrypt rate limit
    # Rate limit active until: 2026-04-25 11:35:25 UTC
    # WARNING: Certificate will be self-signed and trigger browser warnings
    # This is acceptable for emergency unblocking of monitoring/DAST endpoints
    tls internal {
        on_demand
    }

    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # ────────────────────────────────────────────────────────────────────────────
    # Health Check Endpoints (always respond, no auth)
    # ────────────────────────────────────────────────────────────────────────────
    @health path /health /healthz /ping
    respond @health "OK" 200

    # ────────────────────────────────────────────────────────────────────────────
    # OAuth2-Proxy Authentication Gate (default — all other traffic)
    # oauth2-proxy handles Google OAuth flow and upstream proxy to code-server
    # ────────────────────────────────────────────────────────────────────────────
    reverse_proxy oauth2-proxy:4180 {
        header_up Host ide.kushnir.cloud
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
        fail_duration 5s
        max_fails 3
        health_uri /ping
        health_interval 5s
        health_timeout 2s
    }
}

kushnir.cloud {
    # Issue #1686 FIX: Use internal certificates to bypass Let's Encrypt rate limit
    # Rate limit active until: 2026-04-25 11:35:25 UTC
    tls internal {
        on_demand
    }

    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    @health path /health /healthz /ping
    respond @health "OK" 200

    # oauth2-proxy-portal sign-in gate for portal domain
    reverse_proxy oauth2-proxy-portal:4181 {
        header_up Host kushnir.cloud
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
        fail_duration 5s
        max_fails 3
        health_uri /ping
        health_interval 5s
        health_timeout 2s
    }
}

# ════════════════════════════════════════════════════════════════════════════════
# Custom Domain Routing — Dynamic Whitelabel Domains
# All custom domains (e.g., customer.example.com) route through saas-api
# Caddy auto-provisions TLS via Let's Encrypt (ACME challenge via DNS01)
# Note: ide.kushnir.cloud is explicitly handled above and takes precedence
# ════════════════════════════════════════════════════════════════════════════════

*.kushnir.cloud {
    # Issue #1686 FIX: Use internal certificates to bypass Let's Encrypt rate limit
    # Rate limit active until: 2026-04-25 11:35:25 UTC
    tls internal {
        on_demand
    }

    encode gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
        X-Custom-Domain {http.request.host}
    }

    @health path /health /healthz /ping
    respond @health "OK" 200

    # Route custom domain traffic to saas-api with domain context
    # saas-api:5000 handles domain lookups, Appsmith redirection, branding
    reverse_proxy saas-api:5000 {
        header_up Host {http.request.host}
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
        header_up X-Custom-Domain {http.request.host}
        fail_duration 5s
        max_fails 3
        health_uri /health
        health_interval 5s
        health_timeout 2s
    }
}