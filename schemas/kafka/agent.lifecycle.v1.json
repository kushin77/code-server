{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.kushnir.cloud/kafka/agent.lifecycle.v1.json",
  "title": "Agent Lifecycle Event",
  "description": "Agent spawn/complete/fail/timeout events",
  "allOf": [
    {
      "$ref": "event-envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "agent.lifecycle"
        },
        "payload": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["spawn", "complete", "fail", "timeout", "suspended"],
              "description": "Lifecycle event type"
            },
            "agent_id": {
              "type": "string",
              "description": "Unique identifier for the agent"
            },
            "agent_type": {
              "type": "string",
              "description": "Agent type/capability (e.g., incident-responder, code-reviewer)"
            },
            "parent_task_id": {
              "type": "string",
              "description": "Task that spawned this agent"
            },
            "start_time": {
              "type": "string",
              "format": "date-time",
              "description": "When agent execution started"
            },
            "end_time": {
              "type": "string",
              "format": "date-time",
              "description": "When agent execution ended"
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "description": "Total execution time in milliseconds"
            },
            "tokens_used": {
              "type": "integer",
              "minimum": 0,
              "description": "Total tokens consumed by agent"
            },
            "success": {
              "type": "boolean",
              "description": "Whether agent completed successfully"
            },
            "error": {
              "type": "string",
              "description": "Error message if failed"
            },
            "output": {
              "type": "object",
              "description": "Agent output/results"
            }
          },
          "required": ["action", "agent_id", "start_time"],
          "additionalProperties": true
        }
      }
    }
  ]
}
