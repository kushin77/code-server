# Alert Configuration for code-server Operational Monitoring
# This file controls which alert channels are enabled and how alerts are routed

# ============================================================================
# SLACK ALERT CONFIGURATION
# ============================================================================

# Enable Slack alerts (true/false)
ALERT_SLACK_ENABLED=false

# Slack webhook URL (get from Slack workspace app integration)
# https://api.slack.com/messaging/webhooks
# Example: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_URL=""

# ============================================================================
# EMAIL ALERT CONFIGURATION
# ============================================================================

# Enable email alerts (true/false)
ALERT_EMAIL_ENABLED=false

# Email address to send alerts to (comma-separated for multiple)
# Requires 'mail' command available on system
EMAIL_TO=""

# ============================================================================
# SYSLOG CONFIGURATION
# ============================================================================

# Enable syslog alerts (true/false) - always available, recommended to keep enabled
ALERT_SYSLOG_ENABLED=true

# ============================================================================
# ALERT THRESHOLDS
# ============================================================================

# Drift detection: Alert if more than this many resources show drift
DRIFT_ALERT_THRESHOLD=5

# Health checks: Alert if more than this many containers are unhealthy
HEALTH_ALERT_THRESHOLD=1

# Container parity: Alert if difference between primary and replica exceeds this
PARITY_ALERT_THRESHOLD=2

# Disk space: Alert if any host exceeds this percentage usage
DISK_ALERT_THRESHOLD=80

# SLO breach: Alert if any SLO falls below this percentage
SLO_ALERT_THRESHOLD=95

# ============================================================================
# ALERT SUPPRESSION (Avoid duplicate alerts within time window)
# ============================================================================

# Suppress duplicate alerts from same source/title if sent within this many seconds
ALERT_SUPPRESS_WINDOW=300  # 5 minutes

# ============================================================================
# DRIFT MONITORING ALERTS
# ============================================================================

# Alert on new drift detected
ALERT_ON_DRIFT_DETECTED=true

# Alert on drift recovery (resource became compliant)
ALERT_ON_DRIFT_RECOVERY=false

# Alert on drift increase (more resources drifted than last check)
ALERT_ON_DRIFT_INCREASE=true

# ============================================================================
# HEALTH MONITORING ALERTS
# ============================================================================

# Alert on container becoming unhealthy
ALERT_ON_CONTAINER_UNHEALTHY=true

# Alert on container recovery (becomes healthy again)
ALERT_ON_CONTAINER_HEALTHY=false

# Alert on container parity mismatch
ALERT_ON_PARITY_MISMATCH=true

# ============================================================================
# SLO ALERTS
# ============================================================================

# Alert on availability SLO breach
ALERT_ON_AVAILABILITY_BREACH=true

# Alert on deployment success SLO breach
ALERT_ON_DEPLOYMENT_BREACH=true

# Alert on drift-free SLO breach
ALERT_ON_DRIFT_FREE_BREACH=true

# Alert on health check SLO breach
ALERT_ON_HEALTH_BREACH=true

# ============================================================================
# SYSTEM ALERTS
# ============================================================================

# Alert on disk space high
ALERT_ON_DISK_HIGH=true

# Alert on SSH connection failure
ALERT_ON_SSH_FAILURE=true

# Alert on Docker daemon unavailable
ALERT_ON_DOCKER_UNAVAILABLE=true

# Alert on keepalived VRRP down
ALERT_ON_KEEPALIVED_DOWN=true

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================

# To enable Slack alerts:
# 1. Create a Slack App: https://api.slack.com/apps
# 2. Enable Incoming Webhooks
# 3. Add New Webhook to Workspace, select channel
# 4. Copy webhook URL and set SLACK_WEBHOOK_URL below
# 5. Set ALERT_SLACK_ENABLED=true

# To enable Email alerts:
# 1. Install postfix or similar mail service on system
# 2. Test: echo "test" | mail -s "test" your-email@example.com
# 3. Set EMAIL_TO to recipient address
# 4. Set ALERT_EMAIL_ENABLED=true

# To view alerts in syslog:
# - Linux: journalctl -u code-server-ops -f
# - Older systems: tail -f /var/log/syslog | grep code-server-ops

# ============================================================================
# TESTING
# ============================================================================

# Test alert delivery:
#   source .alerts/config.env
#   source scripts/lib/alert-router.sh
#   send_alert WARNING test-source "Test Alert" "This is a test alert"
