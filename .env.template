# Appsmith OAuth Environment Variables Template
# This file should be copied to .env and filled with your actual credentials
# IMPORTANT: .env should never be committed to git
# Usage: Copy to .env, fill in your values, then: chmod 600 .env

# ============================================
# Google OAuth Configuration (REQUIRED)
# ============================================
# These values come from Google Cloud Console
# See: GOOGLE_OAUTH_SETUP_GUIDE.md Steps 1-3

# Get your Client ID from Google Cloud Console
# Format: your-project-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Get your Client Secret from Google Cloud Console
# WARNING: Keep this secret! Do not share or commit to git
OAUTH_GOOGLE_CLIENT_SECRET=your-client-secret

# ============================================
# Appsmith Configuration
# ============================================
# Appsmith instance name (displayed in UI)
APPSMITH_INSTANCE_NAME=kushnir-cloud-ide

# Disable Appsmith telemetry (recommended for security)
APPSMITH_DISABLE_TELEMETRY=true

# Email configuration (set to false if no email setup)
APPSMITH_MAIL_ENABLED=false

# ============================================
# Optional: GitHub OAuth (leave blank if not needed)
# ============================================
# If you want GitHub OAuth login as backup/alternative
# See: https://github.com/settings/developers

# OAUTH_GITHUB_CLIENT_ID=your-github-client-id
# OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# Optional: Google Maps API (leave blank if not needed)
# ============================================
# If Appsmith dashboard needs Google Maps visualization

# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================
# Optional: Email Configuration (leave blank if APPSMITH_MAIL_ENABLED=false)
# ============================================
# APPSMITH_MAIL_HOST=smtp.gmail.com
# APPSMITH_MAIL_PORT=465
# APPSMITH_MAIL_USERNAME=your-email@gmail.com
# APPSMITH_MAIL_PASSWORD=your-app-specific-password

# ============================================
# Setup Instructions
# ============================================
# 1. Get credentials:
#    - Go to GOOGLE_OAUTH_SETUP_GUIDE.md
#    - Follow Steps 1-3 to create OAuth credentials
#    - Copy Client ID and Client Secret

# 2. Fill in this file:
#    - Replace "your-client-id.apps.googleusercontent.com" with your Client ID
#    - Replace "your-client-secret" with your Client Secret

# 3. Save as .env:
#    - cp .env.template .env
#    - chmod 600 .env

# 4. Verify configuration:
#    - ./verify-appsmith-oauth.sh

# 5. Deploy:
#    - source .env
#    - docker compose -f docker-compose.enterprise.yml up -d code-server-appsmith

# ============================================
# Security Warnings
# ============================================
# - Never commit .env to git
# - Ensure .env is chmod 600 (only owner can read)
# - Never share OAUTH_GOOGLE_CLIENT_SECRET
# - Rotate credentials every 90 days
# - Monitor logs for auth failures
