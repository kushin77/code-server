# OIDC Issuer Configuration for Phase 2.1
# Add these variables to .env on the primary host.
# Populate secrets locally from GSM or vault; do not commit PEM material.

OIDC_ISSUER_SIGNING_KEY=REDACTED_SET_VIA_GSM_OR_VAULT
OIDC_ISSUER_PUBLIC_KEY=REDACTED_PUBLIC_KEY_FROM_GSM_OR_VAULT

OIDC_JWT_AUDIENCE=code-server,api,github-actions,kubernetes
OIDC_JWT_CLAIMS_GROUPS=true
OIDC_JWT_EXPIRATION=3600
OIDC_JWT_SIGNING_METHOD=RS256

OAUTH2_PROXY_JWT_ISSUER=https://ide.kushnir.cloud
OAUTH2_PROXY_JWT_KEY_FILE=/etc/oauth2-proxy/oidc-signing-key.pem
OAUTH2_PROXY_OIDC_ALLOWED_AUDIENCES=code-server,api,github-actions,kubernetes

GITHUB_ACTIONS_OIDC_ENABLED=true
GITHUB_ACTIONS_OIDC_SUBJECT_CLAIM=sub
GITHUB_ACTIONS_OIDC_ACTOR_CLAIM=actor
GITHUB_ACTIONS_OIDC_REPO_CLAIM=repository

KUBERNETES_OIDC_ENABLED=true
KUBERNETES_OIDC_SUBJECT_CLAIM=sub
KUBERNETES_OIDC_GROUPS_CLAIM=groups
KUBERNETES_OIDC_ISSUER=https://ide.kushnir.cloud

OIDC_TOKEN_CACHE_TTL=300
OIDC_JWKS_CACHE_TTL=3600
