{
  "pageId": "appsmith-portal-home",
  "name": "Kushnir.cloud Portal",
  "pages": [
    {
      "id": "page1",
      "isHidden": false,
      "isDefault": true,
      "title": "Dashboard"
    }
  ],
  "widgets": [
    {
      "type": "Header",
      "id": "header1",
      "name": "KC Logo Header",
      "properties": {
        "text": "Kushnir.cloud",
        "textAlign": "LEFT",
        "backgroundColor": "#1e293b"
      }
    },
    {
      "type": "Image",
      "id": "logo1",
      "name": "KC Logo",
      "properties": {
        "source": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'%3E%3Crect fill='%234f46e5' width='200' height='200'/%3E%3Ctext x='50%25' y='50%25' fontSize='32' fill='white' textAnchor='middle' dominantBaseline='middle'%3EKC%3C/text%3E%3C/svg%3E",
        "width": 100,
        "height": 100,
        "objectFit": "contain"
      }
    },
    {
      "type": "Text",
      "id": "title1",
      "name": "Portal Title",
      "properties": {
        "text": "Development Infrastructure Portal",
        "fontSize": "24px",
        "fontWeight": "bold",
        "color": "#1e293b"
      }
    },
    {
      "type": "Container",
      "id": "status_section",
      "name": "Service Status",
      "widgets": [
        {
          "type": "Stat",
          "id": "stat_cluster",
          "name": "Cluster Status",
          "properties": {
            "metricName": "Cluster Health",
            "metricValue": "✅ OPERATIONAL",
            "color": "#10b981"
          }
        },
        {
          "type": "Stat",
          "id": "stat_r31",
          "name": "Replica 1",
          "properties": {
            "metricName": "192.168.168.31",
            "metricValue": "✅ HEALTHY",
            "color": "#10b981"
          }
        },
        {
          "type": "Stat",
          "id": "stat_r42",
          "name": "Replica 2",
          "properties": {
            "metricName": "192.168.168.42",
            "metricValue": "✅ HEALTHY",
            "color": "#10b981"
          }
        }
      ]
    },
    {
      "type": "Container",
      "id": "user_section",
      "name": "User Profile",
      "widgets": [
        {
          "type": "Text",
          "id": "user_label",
          "properties": {
            "text": "Logged in as: {{appsmith.user.email}}"
          }
        },
        {
          "type": "Text",
          "id": "user_org",
          "properties": {
            "text": "Organization: Kushnir.cloud"
          }
        }
      ]
    },
    {
      "type": "Container",
      "id": "navigation_section",
      "name": "Navigation",
      "widgets": [
        {
          "type": "Button",
          "id": "btn_ide",
          "name": "IDE Link",
          "properties": {
            "label": "Open VS Code IDE",
            "onClick": "navigateTo('https://ide.kushnir.cloud', {newWindow: true})",
            "backgroundColor": "#4f46e5",
            "textColor": "#ffffff"
          }
        },
        {
          "type": "Button",
          "id": "btn_grafana",
          "name": "Monitoring",
          "properties": {
            "label": "Cluster Monitoring",
            "onClick": "navigateTo('https://ide.kushnir.cloud/grafana', {newWindow: true})",
            "backgroundColor": "#8b5cf6",
            "textColor": "#ffffff"
          }
        },
        {
          "type": "Button",
          "id": "btn_docs",
          "name": "Documentation",
          "properties": {
            "label": "Documentation",
            "onClick": "navigateTo('https://github.com/kushin77/code-server', {newWindow: true})",
            "backgroundColor": "#6366f1",
            "textColor": "#ffffff"
          }
        }
      ]
    }
  ],
  "metadata": {
    "name": "Kushnir.cloud Portal",
    "appId": "kushnir-cloud-portal",
    "version": "1.0.0",
    "createdAt": "2026-04-24T03:20:00Z",
    "branding": {
      "logo": "KC",
      "primaryColor": "#4f46e5",
      "backgroundColor": "#f8fafc",
      "textColor": "#1e293b"
    }
  }
}