# Agent Execution Safeguards - Prevent Uncontrolled Autonomous Expansion
# 
# This file defines explicit boundaries for autonomous agent behavior to prevent
# token waste and unintended large-scale expansions without user approval.
#
# Usage: source .env.agent-safeguards in agent execution context

# ============================================================================
# Autonomous Execution Mode
# ============================================================================

# AGENT_SAFEGUARDS_ENABLED: Enable/disable safeguard checks
export AGENT_SAFEGUARDS_ENABLED="${AGENT_SAFEGUARDS_ENABLED:-true}"

# AGENT_MODE: Execution mode - "guided" requires confirmation, "task" completes stated goal only
# guided   = Ask for confirmation before major actions
# task     = Complete only the stated goal, then stop
# limited  = Maximum 1 task per invocation
export AGENT_MODE="${AGENT_MODE:-task}"

# SHARED_ENVIRONMENT_MODE: Acknowledge this is a shared infrastructure space
# When true: Ignore unrelated projects, never modify other namespaces, only touch code-server
export SHARED_ENVIRONMENT_MODE="${SHARED_ENVIRONMENT_MODE:-true}"

# ============================================================================
# Task Boundary Configuration
# ============================================================================

# AGENT_TASK_SCOPE: What counts as "continue"?
# "stated_goal_only"  = Complete ONLY what was explicitly asked, then stop
# "full_handoff"      = Complete goal + deliver results + ask what's next
# "unlimited_scaling" = DISABLED - never assume unlimited expansion
export AGENT_TASK_SCOPE="${AGENT_TASK_SCOPE:-stated_goal_only}"

# AGENT_AUTO_EXPANSION_ENABLED: Allow autonomous phase/feature expansion?
# false = NEVER autonomously expand beyond stated request
# true  = Only if explicitly requested with count (e.g., "expand to phase 700")
export AGENT_AUTO_EXPANSION_ENABLED="${AGENT_AUTO_EXPANSION_ENABLED:-false}"

# ============================================================================
# Cost Awareness
# ============================================================================

# TOKEN_BUDGET_PER_TASK: Rough token budget per invocation (advisory)
# Helps prevent long-running waste. Set to 0 to disable.
export TOKEN_BUDGET_PER_TASK="${TOKEN_BUDGET_PER_TASK:-0}"

# MAX_FILES_PER_OPERATION: Prevent massive batch file creation
# If creating more than this many files, require explicit confirmation
export MAX_FILES_PER_OPERATION="${MAX_FILES_PER_OPERATION:-10}"

# MAX_GIT_COMMITS_PER_TASK: Prevent excessive commit spam
# If creating more than this many commits without asking, stop
export MAX_GIT_COMMITS_PER_TASK="${MAX_GIT_COMMITS_PER_TASK:-2}"

# ============================================================================
# Shared Environment Boundaries
# ============================================================================

# DEPLOYMENT_SCOPE: Only modify resources part of code-server deployment
# code-server   = 192.168.168.31 (primary), 192.168.168.42 (replica)
# IN_SCOPE = code-server containers, terraform/environments/private, docker-compose.enterprise.yml
# OUT_OF_SCOPE = Other projects, other namespaces, other VMs, shared services not owned
export DEPLOYMENT_SCOPE="${DEPLOYMENT_SCOPE:-code-server-only}"

# MODIFICATION_TARGETS: Only touch these resource patterns
# ✓ Apps in: apps/ (code-server owned)
# ✓ Terraform in: terraform/environments/private/
# ✓ Docker in: docker-compose.enterprise.yml, docker-compose.*.yml (code-server scoped)
# ✓ Scripts in: scripts/ (code-server only, not shared infra scripts)
# ✗ NEVER: Shared infrastructure (other VMs, public services, other projects)
export MODIFICATION_TARGETS="${MODIFICATION_TARGETS:-code-server-deployment}"

# RESTART_POLICY: Only restart code-server containers, never touch shared services
# Never restart: nginx, caddy, other shared reverse proxies not explicitly owned
# Never touch: PostgreSQL outside code-server scope, Redis without consent
# Never modify: Network config, firewall rules, system-level services
export RESTART_POLICY="${RESTART_POLICY:-code-server-containers-only}"

# EXPLICIT_SCOPE_BOUNDARIES: What is definitively NOT the agent's responsibility
# - Other projects in the shared workspace
# - Shared infrastructure services
# - Other namespace deployments
# - System-level configuration outside code-server scope
export SCOPE_BOUNDARIES="${SCOPE_BOUNDARIES:-honor-explicit-boundaries-only}"

# ============================================================================
# Checkpoint & Confirmation Requirements
# ============================================================================

# REQUIRE_CONFIRMATION_FOR: Require explicit user confirmation before:
# - major_expansion  = Creating 50+ validators/phases
# - doc_generation   = Creating 5+ documentation files
# - git_deployment   = Pushing 3+ commits
# - api_calls        = Making 100+ API calls
export REQUIRE_CONFIRMATION_FOR="${REQUIRE_CONFIRMATION_FOR:-major_expansion,doc_generation,git_deployment}"

# COMPLETION_CHECKPOINT: When to report completion and ask for next direction
# "after_stated_goal"  = Stop after completing what was explicitly asked
# "after_validation"   = Stop after validation/testing, ask before cleanup
# "never_auto_cleanup" = Never autonomously delete or revert work
export COMPLETION_CHECKPOINT="${COMPLETION_CHECKPOINT:-after_stated_goal}"

# ============================================================================
# Behavior Boundaries
# ============================================================================

# AGENT_AUTO_LOOP_PREVENTION: Prevent continuous autonomous loops
# If true, agent must receive explicit new input between tasks
export AGENT_AUTO_LOOP_PREVENTION="${AGENT_AUTO_LOOP_PREVENTION:-true}"

# AGENT_MUST_REPORT_COMPLETION: Always call task_complete after work
# Prevents silent continuation to next task
export AGENT_MUST_REPORT_COMPLETION="${AGENT_MUST_REPORT_COMPLETION:-true}"

# AGENT_EXPLAIN_DECISIONS: Explain major execution decisions before acting
# If true, describe what's about to happen and wait for confirmation
export AGENT_EXPLAIN_DECISIONS="${AGENT_EXPLAIN_DECISIONS:-true}"

# ============================================================================
# Logging & Audit Trail
# ============================================================================

# AGENT_DECISION_LOG: Log file for autonomous decisions (for audit)
export AGENT_DECISION_LOG="${AGENT_DECISION_LOG:-./.agent-decisions.log}"

# AGENT_LOG_LEVEL: What to log - "verbose" logs all decisions, "errors" logs problems only
export AGENT_LOG_LEVEL="${AGENT_LOG_LEVEL:-verbose}"

# ============================================================================
# Emergency Stop Pattern
# ============================================================================

# If a task takes too long or creates too much, this env var can pause it
# Set AGENT_EMERGENCY_STOP=true to halt current operation
export AGENT_EMERGENCY_STOP="${AGENT_EMERGENCY_STOP:-false}"

# ============================================================================
# Default Safe Behavior Summary
# ============================================================================
#
# DEFAULT SAFE MODE (safeguards enabled):
# 1. Agent completes ONLY what was explicitly asked
# 2. Agent reports completion and asks for next direction
# 3. NO autonomous expansion beyond stated request
# 4. NO creation of 50+ files without confirmation
# 5. NO deployment of 3+ commits without confirmation
# 6. Every major decision must be explained before execution
#
# To disable safeguards (NOT RECOMMENDED): AGENT_SAFEGUARDS_ENABLED=false
#
