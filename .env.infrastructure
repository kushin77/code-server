# Environment Configuration - Infrastructure URLs and Endpoints
# P3 #1533 Phase 3: Externalized configuration for IaC compliance and idempotency
# 
# This file defines all service endpoints and infrastructure URLs as environment variables
# to enable environment-driven configuration and support IaC/idempotent deployment patterns.
#
# Usage: source .env.infrastructure before running deployment scripts

# ============================================================================
# API Protocol and Host Components (for templated endpoint construction)
# ============================================================================

# API protocol (http or https)
export API_PROTOCOL="${API_PROTOCOL:-http}"

# API hostname/IP
export API_HOST="${API_HOST:-localhost}"

# API port
export API_PORT="${API_PORT:-8080}"

# ============================================================================
# API and Service Endpoints
# ============================================================================

# API Gateway endpoint (constructed from components above)
export API_ENDPOINT="http://${API_HOST}:${API_PORT}"
export API_HEALTH_ENDPOINT="http://${API_HOST}:${API_PORT}/health"
export API_OAUTH_CALLBACK="http://${API_HOST}:${API_PORT}/oauth/callback"

# Policy engine (OPA)
export OPA_ENDPOINT="${OPA_ENDPOINT:-http://localhost:8181}"

# Memory service endpoint
MEMORY_SERVICE_ENDPOINT=${MEMORY_SERVICE_ENDPOINT:-http://localhost:8000}

# Monitoring services
GRAFANA_ENDPOINT=${GRAFANA_ENDPOINT:-http://localhost:3000}
PROMETHEUS_ENDPOINT=${PROMETHEUS_ENDPOINT:-http://localhost:9090}

# Kafka/Redpanda
KAFKA_BROKER=${KAFKA_BROKER:-localhost:9093}
KAFKA_JMX_EXPORTER=${KAFKA_JMX_EXPORTER:-localhost:9308}

# ============================================================================
# Infrastructure Hosts
# ============================================================================

# Production hosts
PRIMARY_HOST=${PRIMARY_HOST:?PRIMARY_HOST must be set}
REPLICA_HOST=${REPLICA_HOST:?REPLICA_HOST must be set}

# Multi-node Caddy load balancing: set REPLICA_BACKEND to enable cross-node routing.
# Format: http://<replica-host>:<port>  — must match the service's host-facing port.
# Leave empty on single-node deployments.
REPLICA_BACKEND=${REPLICA_BACKEND:-http://${REPLICA_HOST}:8010}

# NAS and storage
NAS_HOST=${NAS_HOST:?NAS_HOST must be set}
NAS_MOUNT_PATH=${NAS_MOUNT_PATH:-/mnt/nas}

# ============================================================================
# Health Check Configuration
# ============================================================================

HEALTH_CHECK_TIMEOUT=${HEALTH_CHECK_TIMEOUT:-300}
HEALTH_CHECK_MAX_ATTEMPTS=${HEALTH_CHECK_MAX_ATTEMPTS:-30}
HEALTH_CHECK_INTERVAL=${HEALTH_CHECK_INTERVAL:-10}

# ============================================================================
# Deployment Configuration
# ============================================================================

DEPLOYMENT_AUTO_ROLLBACK=${DEPLOYMENT_AUTO_ROLLBACK:-true}
DEPLOYMENT_VERIFICATION_TIMEOUT=${DEPLOYMENT_VERIFICATION_TIMEOUT:-600}
