version: "1"

runtime:
  mode: local
  fallback: none
  resource_limits:
    cpu: 4
    memory: 8Gi

services:
  - name: postgres
    image: postgres:16@sha256:abc123
    persistent: true
    env:
      POSTGRES_DB: appdb
      POSTGRES_USER: app
      POSTGRES_PASSWORD: "${DB_PASSWORD}"
  
  - name: redis
    image: redis:7@sha256:def456
    persistent: false
  
  - name: ollama
    image: ollama/ollama:latest@sha256:ghi789
    persistent: true
    env:
      OLLAMA_BASE_URL: http://ollama:11434

ai:
  model: llama3:8b
  provider: ollama
  fallback_chain:
    - local
  constraints:
    - no_external_unless_explicit
    - prompt_pii_scan
    - log_all_interactions

policies:
  - no_prod_without_human
  - secrets_never_leave_boundary
  - full_audit_all_actions

compliance:
  frameworks:
    - SOC2
    - NIST-800-53
  data_classification: internal
