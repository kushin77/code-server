# Phase 2: Service-to-Service JWT Authentication Configuration
# This template documents the environment variables required for Phase 2 deployment
# 
# INSTRUCTIONS:
# 1. Copy this file as reference: cp .env.phase-2-template .env.phase-2-local
# 2. Fill in the values from Google Secret Manager or your vault
# 3. Source this file when deploying: source .env.phase-2-local && docker-compose up -d
#
# All values MUST come from GSM or vault - NEVER commit secrets to git
# See scripts/fetch-gsm-secrets.sh for GSM integration

# ============= OIDC Issuer Configuration =============
# oauth2-oidc-issuer service for issuing JWT tokens

# OIDC Issuer URL - where the service is running
# On-prem: http://oauth2-oidc-issuer:4182 (internal Docker network)
# Cloud: https://oidc.kushnir.cloud (external)
OIDC_ISSUER_URL=http://oauth2-oidc-issuer:4182

# RSA Private Key (2048-bit PKCS#1 PEM format) for JWT signing with RS256
# Generate: openssl genrsa -out private_key.pem 2048
# FETCH FROM GSM: gcloud secrets versions access latest --secret=oidc-issuer-signing-key
OIDC_ISSUER_SIGNING_KEY=-----BEGIN RSA PRIVATE KEY-----
PLACEHOLDER_RSA_KEY_CONTENT
-----END RSA PRIVATE KEY-----

# ============= Service Account Credentials =============
# Each service needs a client_id and client_secret to acquire tokens

# Session-Broker Service Account
# Used by session-broker to call code-server APIs
SERVICE_CLIENT_SESSION_BROKER_ID=session-broker
SERVICE_CLIENT_SESSION_BROKER_SECRET=32_CHAR_RANDOM_SECRET_FROM_GSM

# Backend Service Account
# Used by code-server backend to call other service APIs
SERVICE_CLIENT_BACKEND_ID=backend
SERVICE_CLIENT_BACKEND_SECRET=32_CHAR_RANDOM_SECRET_FROM_GSM

# ============= Load Balancer Session Cookie Secret =============
# Caddy uses this as HMAC key for sticky-session cookies
# MUST be same on both primary and replica hosts for cross-host failover
# Generate: openssl rand -hex 32
IDE_SESSION_LB_SECRET=64_HEX_CHAR_SECRET_FROM_GSM

# ============= GSM Integration =============
# Run scripts/fetch-gsm-secrets.sh to populate above variables
# That script will:
# 1. Connect to Google Secret Manager
# 2. Fetch: oidc-issuer-signing-key
# 3. Fetch: service-client-session-broker-secret
# 4. Fetch: service-client-backend-secret
# 5. Fetch: ide-session-lb-secret
# 6. Write values into .env or environment

# ============= Deployment Verification =============
# After setting variables, run:
# bash scripts/ci/check-phase-2-jwt-readiness.sh
#
# This validates:
# - All required variables set
# - OIDC issuer responding on OIDC_ISSUER_URL
# - JWKS endpoint accessible
# - Token issuance works with service credentials
# - All variables properly escaped (no shell injection issues)

# ============= Testing JWT Token Acquisition =============
# Test token acquisition locally:
#
# OIDC_URL=http://localhost:4182
# CLIENT_ID=session-broker
# CLIENT_SECRET=YOUR_SECRET
#
# curl -X POST $OIDC_URL/oauth2/token \
#   -d "grant_type=client_credentials" \
#   -d "client_id=$CLIENT_ID" \
#   -d "client_secret=$CLIENT_SECRET" \
#   -d "scope=read:sessions write:sessions" \
#   -H "Content-Type: application/x-www-form-urlencoded"
#
# Response should include "access_token" with RS256-signed JWT

# ============= Multi-Host Deployment =============
# When deploying to replica (192.168.168.42):
# 1. Copy this configuration to replica host
# 2. All service account secrets MUST be identical
# 3. IDE_SESSION_LB_SECRET MUST be identical (same HMAC key)
# 4. OIDC_ISSUER_URL should point to primary: http://192.168.168.31:4182
#    (or use DNS name if available)
# 5. Run identical docker-compose up -d

