# Minimal Caddyfile for on-prem OAuth testing
# Generated for Issue #984 - QA OAuth automation

{
    email {$ACME_EMAIL:admin@kushnir.cloud}
    acme_ca https://acme-v02.api.letsencrypt.org/directory
    admin localhost:2019 {
        origins localhost
    }
}

# IDE domain - proxy to code-server via oauth2-proxy
{$IDE_DOMAIN:ide.kushnir.cloud}:80, {$IDE_DOMAIN:ide.kushnir.cloud}:443 {
    encode gzip

    # Health check
    @health path /health /healthz /ping
    respond @health "OK" 200

    # OAuth2-proxy on port 4180
    reverse_proxy 172.28.1.2:4180 {
        header_up Host {$IDE_DOMAIN:ide.kushnir.cloud}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
    }
}

# Portal domain (same as IDE domain in test)
{$PORTAL_DOMAIN:kushnir.cloud}:80, {$PORTAL_DOMAIN:kushnir.cloud}:443 {
    encode gzip

    @health path /health /healthz /ping
    respond @health "OK" 200

    # OAuth2-proxy on port 4180
    reverse_proxy 172.28.1.2:4180 {
